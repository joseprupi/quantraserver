# Quantra C++ formatting. Formalises the style the code already uses:
# 4-space indent, attached (K&R) braces, left pointer alignment, west const,
# 100-column limit, "} // namespace x" closers, grouped + sorted includes.
# Apply with scripts/format.sh. Written against clang-format 23.1.3
# (pip wheel `clang-format==23.1.3`); other majors may differ slightly.
---
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
AccessModifierOffset: -4
IndentCaseLabels: true

BreakBeforeBraces: Attach
PointerAlignment: Left
QualifierAlignment: Left
FixNamespaceComments: true
CompactNamespaces: true

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortCaseLabelsOnASingleLine: true
AlignAfterOpenBracket: AlwaysBreak
BinPackParameters: OnePerLine
PenaltyReturnTypeOnItsOwnLine: 1000

# Keep error-message strings and comments greppable: never split them.
BreakStringLiterals: false
ReflowComments: false

# Include order: own header, project "..." headers, generated FlatBuffers/gRPC
# headers, <ql/...>, third-party (<flatbuffers/..>, <grpc..>, <gtest/..>), std.
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
IncludeIsMainRegex: '([-_](test|unittest))?$'
IncludeCategories:
  - Regex: '^"flatbuffers/'
    Priority: 4
  - Regex: '(_generated\.h|\.grpc\.fb\.h)"'
    Priority: 2
  - Regex: '^"'
    Priority: 1
  - Regex: '^<ql/'
    Priority: 3
  - Regex: '^<(flatbuffers|grpc|grpcpp|gtest|openssl|boost)/'
    Priority: 4
  - Regex: '^<'
    Priority: 5
