include "enums.fbs";
include "common.fbs";

namespace quantra;

/// 2D quote matrix (expiries x tenors).
table QuoteMatrix2D {
    n_rows:int;
    n_cols:int;
    /// Row-major, length = n_rows*n_cols.
    values:[double];
    /// Optional, length = values. Empty => inline values.
    quote_ids:[string];
}

/// 3D quote tensor (expiries x tenors x strikes).
table QuoteTensor3D {
    n_1:int;
    n_2:int;
    n_3:int;
    /// Row-major, length = n_1*n_2*n_3.
    values:[double];
    /// Optional, length = values. Empty => inline values.
    quote_ids:[string];
}

/// IR volatility base (Normal, Lognormal, ShiftedLognormal). Supports caps/floors and swaptions.
table IrVolBaseSpec {
    reference_date:string;
    calendar:enums.Calendar;
    business_day_convention:enums.BusinessDayConvention;
    day_counter:enums.DayCounter;
    shape:enums.VolSurfaceShape = Constant;
    volatility_type:enums.VolatilityType;
    /// Only meaningful for ShiftedLognormal.
    displacement:double = 0.0;
    constant_vol:double;
    /// Optional: resolve constant_vol from pricing.quotes.
    quote_id:string;
}

/// Equity/FX volatility base (always lognormal, no displacement).
table BlackVolBaseSpec {
    reference_date:string;
    calendar:enums.Calendar;
    business_day_convention:enums.BusinessDayConvention;
    day_counter:enums.DayCounter;
    shape:enums.VolSurfaceShape = Constant;
    constant_vol:double;
    /// Optional: resolve constant_vol from pricing.quotes.
    quote_id:string;
}

/// Optionlet volatility for caps/floors.
table OptionletVolSpec {
    base:IrVolBaseSpec;
}

/// Constant swaption volatility.
table SwaptionVolConstantSpec {
    base:IrVolBaseSpec;
}

/// ATM matrix swaption volatility (expiry x tenor).
table SwaptionVolAtmMatrixSpec {
    base:IrVolBaseSpec;
    expiries:[Period];
    tenors:[Period];
    vols:QuoteMatrix2D;
    expiry_interpolator:enums.Interpolator = Linear;
    tenor_interpolator:enums.Interpolator = Linear;
}

/// Smile cube swaption volatility (expiry x tenor x strike).
table SwaptionVolSmileCubeSpec {
    base:IrVolBaseSpec;
    /// Require explicit opt-in when client provides atm_forwards.
    allow_external_atm:bool = false;
    expiries:[Period];
    tenors:[Period];
    strikes:[double];
    strike_kind:enums.SwaptionStrikeKind = Absolute;
    /// Optional for Absolute, required for SpreadFromATM.
    atm_forwards:QuoteMatrix2D;
    vols:QuoteTensor3D;
    expiry_interpolator:enums.Interpolator = Linear;
    tenor_interpolator:enums.Interpolator = Linear;
    strike_interpolator:enums.Interpolator = Linear;
}

/// SABR parameter grid swaption volatility.
table SwaptionSabrParamsSpec {
    base:IrVolBaseSpec;
    expiries:[Period];
    tenors:[Period];
    alpha:QuoteMatrix2D;
    beta:QuoteMatrix2D;
    rho:QuoteMatrix2D;
    nu:QuoteMatrix2D;
}

/// SABR calibrate swaption volatility.
table SwaptionSabrCalibrateSpec {
    base:IrVolBaseSpec;
    expiries:[Period];
    tenors:[Period];
    strikes:[double];
    vols:QuoteTensor3D;
    beta_fixed:bool = true;
    beta_value:double = 0.5;
    weights:QuoteTensor3D;
}

/// Union of swaption vol payload types.
union SwaptionVolPayload {
    SwaptionVolConstantSpec,
    SwaptionVolAtmMatrixSpec,
    SwaptionVolSmileCubeSpec,
    SwaptionSabrParamsSpec,
    SwaptionSabrCalibrateSpec
}

/// Swaption volatility specification.
table SwaptionVolSpec {
    /// Required convention anchor for all swaption vol surfaces.
    swap_index_id:string;
    payload:SwaptionVolPayload;
}

/// Black volatility for equity/FX/commodity options.
table BlackVolSpec {
    base:BlackVolBaseSpec;
    /// Term/surface expiry pillars from base.reference_date.
    expiries:[Period];
    /// Surface strike axis (required only for shape=SmileCube3D).
    strikes:[double];
    /// Term vols as QuoteMatrix2D with dims (n_expiries x 1), row-major.
    term_vols:QuoteMatrix2D;
    /// Surface vols as QuoteMatrix2D with dims (n_expiries x n_strikes), row-major by expiry then strike.
    surface_vols:QuoteMatrix2D;
    /// Interpolator across expiry dimension for non-constant shapes (Linear only in v1).
    expiry_interpolator:enums.Interpolator = Linear;
    /// Interpolator across strike dimension for shape=SmileCube3D (Linear only in v1).
    strike_interpolator:enums.Interpolator = Linear;
}

/// Union of all volatility types.
union VolPayload { OptionletVolSpec, SwaptionVolSpec, BlackVolSpec }

/// Volatility surface specification referenced by id in trade requests.
table VolSurfaceSpec {
    id:string (required);
    payload:VolPayload;
}
