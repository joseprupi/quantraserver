include "enums.fbs";
include "common.fbs";

namespace quantra;

/// 2D quote matrix (n_rows x n_cols). Interpretation depends on caller.
table QuoteMatrix2D {
    n_rows:int;
    n_cols:int;
    /// Row-major, length = n_rows*n_cols.
    values:[double];
    /// Optional, length = values. Empty => inline values.
    quote_ids:[string];
}

/// 3D quote tensor (n_1 x n_2 x n_3). Interpretation depends on caller.
table QuoteTensor3D {
    n_1:int;
    n_2:int;
    n_3:int;
    /// Row-major, length = n_1*n_2*n_3.
    values:[double];
    /// Optional, length = values. Empty => inline values.
    quote_ids:[string];
}

/// IR volatility base (Normal, Lognormal, ShiftedLognormal). Supports caps/floors and swaptions.
table IrVolBaseSpec {
    reference_date:string;
    calendar:enums.Calendar = null;
    business_day_convention:enums.BusinessDayConvention = null;
    day_counter:enums.DayCounter = null;
    shape:enums.VolSurfaceShape = Constant;
    /// Quotation convention of the supplied vols. Presence-required: an omitted
    /// type is a 400, never the alphabetical-0 default (Normal), which would
    /// price a lognormal-quoted surface as normal vols.
    volatility_type:enums.VolatilityType = null;
    /// Only meaningful for ShiftedLognormal.
    displacement:double = 0.0;
    constant_vol:double;
    /// Optional: resolve constant_vol from pricing.quotes.
    quote_id:string;
}

/// Equity/FX volatility base (always lognormal, no displacement).
table BlackVolBaseSpec {
    reference_date:string;
    calendar:enums.Calendar = null;
    business_day_convention:enums.BusinessDayConvention = null;
    day_counter:enums.DayCounter = null;
    shape:enums.VolSurfaceShape = Constant;
    constant_vol:double;
    /// Optional: resolve constant_vol from pricing.quotes.
    quote_id:string;
}

/// Optionlet volatility for caps/floors.
table OptionletVolSpec {
    base:IrVolBaseSpec;
}

/// Constant swaption volatility.
table SwaptionVolConstantSpec {
    base:IrVolBaseSpec;
}

/// ATM matrix swaption volatility (expiry x tenor).
table SwaptionVolAtmMatrixSpec {
    base:IrVolBaseSpec;
    expiries:[Period];
    tenors:[Period];
    vols:QuoteMatrix2D;
    expiry_interpolator:enums.Interpolator = Linear;
    tenor_interpolator:enums.Interpolator = Linear;
}

/// Smile cube swaption volatility (expiry x tenor x strike).
table SwaptionVolSmileCubeSpec {
    base:IrVolBaseSpec;
    /// Require explicit opt-in when client provides atm_forwards.
    allow_external_atm:bool = false;
    expiries:[Period];
    tenors:[Period];
    strikes:[double];
    strike_kind:enums.SwaptionStrikeKind = Absolute;
    /// Optional for Absolute, required for SpreadFromATM.
    atm_forwards:QuoteMatrix2D;
    vols:QuoteTensor3D;
    expiry_interpolator:enums.Interpolator = Linear;
    tenor_interpolator:enums.Interpolator = Linear;
    strike_interpolator:enums.Interpolator = Linear;
}

/// SABR parameter grid swaption volatility.
table SwaptionSabrParamsSpec {
    base:IrVolBaseSpec;
    expiries:[Period];
    tenors:[Period];
    alpha:QuoteMatrix2D;
    beta:QuoteMatrix2D;
    rho:QuoteMatrix2D;
    nu:QuoteMatrix2D;
}

/// SABR calibrate swaption volatility.
///
/// Strike axis interpretation: `strikes` are spreads from the per-node ATM
/// forward (rate units, e.g. -0.02 = -200bp). The same spread vector applies
/// at every (expiry, tenor) node, matching QuantLib's XabrSwaptionVolatilityCube
/// API. 0.0 spread (true ATM) is not required to be in the grid — per-node ATM
/// vols are interpolated from the user grid at spread=0.
///
/// `vols` is row-major nExp*nTen*nStrikes; values are absolute market vols.
///
/// `weights` is rejected in v1 — set `vega_weighted_smile_fit=true` for
/// vega-weighted fitting instead. Per-strike non-uniform weights are not
/// exposed by QuantLib 1.41's calibrator.
table SwaptionSabrCalibrateSpec {
    base:IrVolBaseSpec;
    expiries:[Period];
    tenors:[Period];
    strikes:[double];
    vols:QuoteTensor3D;
    beta_fixed:bool = true;
    beta_value:double = 0.5;
    /// Reserved. Must be empty/absent in v1; otherwise parse-time rejection.
    weights:QuoteTensor3D;
    /// When true, the SABR calibrator weights residuals by Black vega. This is
    /// the standard "vega-weighted smile fit" QL flag (cube-level, not per
    /// strike).
    vega_weighted_smile_fit:bool = false;
}

/// Union of swaption vol payload types.
union SwaptionVolPayload {
    SwaptionVolConstantSpec,
    SwaptionVolAtmMatrixSpec,
    SwaptionVolSmileCubeSpec,
    SwaptionSabrParamsSpec,
    SwaptionSabrCalibrateSpec
}

/// Swaption volatility specification.
table SwaptionVolSpec {
    /// Required convention anchor for all swaption vol surfaces.
    swap_index_id:string;
    payload:SwaptionVolPayload;
}

/// Black volatility for equity/FX/commodity options.
table BlackVolSpec {
    base:BlackVolBaseSpec;
    /// Term/surface expiry pillars from base.reference_date.
    expiries:[Period];
    /// Surface strike axis (required only for shape=SmileCube3D).
    strikes:[double];
    /// Term vols as QuoteMatrix2D with dims (n_expiries x 1), row-major.
    term_vols:QuoteMatrix2D;
    /// Surface vols as QuoteMatrix2D with dims (n_expiries x n_strikes), row-major by expiry then strike.
    surface_vols:QuoteMatrix2D;
    /// Surface prices as QuoteMatrix2D with dims (n_price_expiries x n_price_strikes), row-major by expiry then strike.
    /// Used only when base.shape=SurfaceFromPrices.
    surface_prices:QuoteMatrix2D;
    /// Absolute expiry dates (YYYY-MM-DD). Used only when base.shape=SurfaceFromPrices.
    price_expiries:[string];
    /// Surface strike axis for prices matrix. Used only when base.shape=SurfaceFromPrices.
    price_strikes:[double];
    /// Option type used for implied-vol inversion from prices. Used only when base.shape=SurfaceFromPrices.
    price_option_type:enums.EquityOptionType = Call;
    /// Spot level for implied-vol inversion. Optional if spot_quote_id is provided.
    spot:double;
    /// Optional: resolve spot from pricing.quotes.
    spot_quote_id:string;
    /// Discount curve id in pricing.curves used for implied-vol inversion.
    discount_curve_id:string;
    /// If true and discount_curve_id is empty, use flat_discount_rate.
    use_flat_discount_rate:bool = false;
    /// Continuously-compounded flat risk-free rate used when use_flat_discount_rate=true.
    flat_discount_rate:double = 0.0;
    /// Dividend yield curve id in pricing.curves used for implied-vol inversion.
    dividend_curve_id:string;
    /// If true and dividend_curve_id is empty, use flat_dividend_rate.
    use_flat_dividend_rate:bool = false;
    /// Continuously-compounded flat dividend yield used when use_flat_dividend_rate=true.
    flat_dividend_rate:double = 0.0;
    /// Default extrapolation mode for this surface when consumed by pricing endpoints.
    allow_extrapolation:bool = false;
    /// Interpolation of a strike x expiry surface (see the enum): Bilinear
    /// unless asked; `/calibrate-vol-surface` returns CubicStrikeLinearTime.
    surface_interpolator:enums.SurfaceInterpolator2D = Bilinear;
    /// Deprecated for BlackVolSpec surfaces; retained for backward compatibility.
    /// Mapping: (Linear,Linear)=>Bilinear, (LogCubic,LogCubic)=>Bicubic.
    expiry_interpolator:enums.Interpolator = Linear;
    /// Deprecated for BlackVolSpec surfaces; retained for backward compatibility.
    /// Mapping: (Linear,Linear)=>Bilinear, (LogCubic,LogCubic)=>Bicubic.
    strike_interpolator:enums.Interpolator = Linear;
    /// Optional. For a strike-dependent surface simulated as Dupire local
    /// vol by a structured note: how the local vol is extended beyond the
    /// last expiry (see the enum). Absent = FlatImpliedVol (the local vol of
    /// the flat-implied-vol extension). `/calibrate-vol-surface` returns
    /// FlatLocalVol. No effect on a Constant or AtmMatrix2D vol, nor on any
    /// Black vol read (vanilla options, diagnostics).
    local_vol_time_extrapolation:enums.LocalVolTimeExtrapolation = null;
    /// Optional, a strike x expiry surface only (SmileCube3D): the strike
    /// range a structured note holds the Dupire local vol to around each
    /// expiry, one entry per `expiries` entry (both arrays or neither, each
    /// > 0, min < max, within the grid's strikes). At time t the local vol
    /// is read at the simulated level clamped to the range of the first
    /// expiry at or after t (the last expiry's beyond it), intersected
    /// within 2e-4 years of an expiry with the range on the other side of
    /// it (since 0.16.9: a read on an expiry evaluates both intervals in
    /// its time stencil), instead of the grid's first and last strike.
    /// Absent: the grid's edges at every time. `/calibrate-vol-surface` fills them with the region it checked
    /// (see `LocalVolCheck`). No Black vol read is affected.
    local_vol_strike_min:[double];
    local_vol_strike_max:[double];
}

/// Constant year-on-year inflation optionlet volatility, referenced by id from
/// year-on-year inflation cap/floor trades. Currently a single flat vol; a
/// strike/tenor surface form is a future additive extension (add optional
/// axis/matrix fields alongside `constant_vol`, mirroring OptionletVolSpec ->
/// AtmMatrix growth). The surface frequency and index-interpolation flag are
/// NOT carried here: they are taken at pricing time from the year-on-year
/// inflation index/curve the trade references, so the vol surface stays
/// convention-consistent with its index.
table YoYOptionletVolSpec {
    /// Flat lognormal/normal optionlet volatility. Presence-required: an
    /// omitted vol is a 400, never a silent 0.0.
    constant_vol:double = null;
    /// Pricing formula / engine selector (Black / UnitDisplacedBlack /
    /// Bachelier). Presence-required.
    vol_type:enums.YoYInflationCapFloorEngineType = null;
    /// Day counter for the vol surface time axis. Presence-required.
    day_counter:enums.DayCounter = null;
    /// Calendar the vol surface advances the reference date on.
    /// Presence-required.
    calendar:enums.Calendar = null;
    /// Business-day convention for the vol surface. Presence-required.
    business_day_convention:enums.BusinessDayConvention = null;
    /// Observation lag of the vol surface (e.g. 3 Months).
    observation_lag:Period (required);
}

/// One expiry of an `SviVolSpec`: the raw SVI total variance
/// w(k) = a + b (rho (k - m) + sqrt((k - m)^2 + sigma^2)), k = ln(K / forward)
/// (Gatheral's raw parameterisation, QuantLib `SviSmileSection`), the Black
/// vol being sqrt(w(k) / T) with T the base day counter's year fraction from
/// the reference date to `expiry`. The formula is global in strike: the
/// Black vol read (vanilla options, diagnostics) has no strike edge.
table SviSlice {
    /// Expiry date (YYYY-MM-DD), strictly after the reference date; slices
    /// must be strictly increasing.
    expiry:string (required);
    /// The forward the slice is written against (the origin of k), > 0.
    forward:double;
    a:double;
    /// b >= 0; the slice must satisfy a + b sigma sqrt(1 - rho^2) >= 0 so the
    /// minimum total variance is not negative.
    b:double;
    /// sigma > 0.
    sigma:double;
    /// -1 < rho < 1.
    rho:double;
    m:double;
    /// Optional: a strike range (absolute, same units as `forward`) around
    /// the slice; `/calibrate-vol-surface` fills both with the region it
    /// checked around the expiry (before 0.16.5: the strikes of the quotes
    /// the slice was fitted to). A raw SVI wing beyond the quotes is an extrapolation that
    /// can carry butterfly arbitrage (Durrleman's g < 0, a negative Dupire
    /// local variance). When present, a structured note holds the local vol
    /// at the strike edge beyond them, as for a grid: with the payload's
    /// `local_vol_strike_range` Global (default) the local vol strike
    /// range is [min of every slice's strike_min, max of every slice's
    /// strike_max] (a slice without one leaves that side open); with
    /// PerExpiry it is this slice's range for the times up to its expiry
    /// (after the previous slice's), intersected with the next slice's
    /// within 2e-4 years of the expiry (see the enum). A simulated level beyond it reads the
    /// local vol at the edge. No Black
    /// vol read is affected (vanilla options read the formula at every
    /// strike). Absent: no edge. Each > 0 and strike_min < strike_max when
    /// both are given (400 otherwise).
    strike_min:double = null;
    strike_max:double = null;
}

/// Black volatility as raw SVI slices (what `/calibrate-vol-surface` with
/// `SviPerExpiry` returns as `vol_surface_spec_svi`): the smile of every
/// quoted expiry with its exact curvature, so that a Dupire local vol
/// derived from it reprices the quotes through a Monte Carlo (the grid of
/// a `BlackVolSpec` loses that curvature between nodes unless it is
/// interpolated with `CubicStrikeLinearTime`). Accepted wherever a Black
/// vol is referenced (`price-equity-option` `volatility`, a structured
/// note's `underlyings[].volatility_id`); strike-dependent, so a structured
/// note simulates it as Dupire local vol with `monte_carlo.steps_per_year`.
/// `base` carries the reference date, calendar, business-day convention and
/// day counter only: `shape` must be left at its default, `constant_vol` and
/// `quote_id` absent (400 otherwise).
table SviVolSpec {
    base:BlackVolBaseSpec;
    /// At least one slice, strictly increasing expiries.
    slices:[SviSlice] (required);
    time_interpolation:enums.SviTimeInterpolation = LinearTotalVariance;
    /// Whether an expiry beyond the last slice may be read at all (flat
    /// implied vol); strikes need no flag, the formula is global.
    allow_extrapolation:bool = false;
    /// Optional. How the Dupire local vol a structured note simulates is
    /// extended beyond the last slice (see the enum). Absent =
    /// FlatImpliedVol. `/calibrate-vol-surface` returns FlatLocalVol. No
    /// effect on any Black vol read (vanilla options, diagnostics).
    local_vol_time_extrapolation:enums.LocalVolTimeExtrapolation = null;
    /// Optional. How the slices' strike_min / strike_max bound the local
    /// vol (see the enum). Absent = Global (one range for every time).
    /// PerExpiry requires strike_min and strike_max on every slice (400
    /// otherwise). `/calibrate-vol-surface` returns PerExpiry with each
    /// slice's checked region. No Black vol read is affected.
    local_vol_strike_range:enums.LocalVolStrikeRange = null;
}

/// One expiry of an `SsviVolSpec`: an eSSVI slice (Corbetta, Cohort,
/// Laachir, Martini 2019, "Robust calibration and arbitrage-free
/// interpolation of SSVI slices"). Total variance at log-forward moneyness
/// k = ln(K / F_ref(T))
///
///     w(k) = 0.5 (theta + rho psi k + sqrt(psi^2 k^2 + 2 rho psi theta k + theta^2)),
///
/// the Black vol being sqrt(w / T), T the base day counter's year fraction
/// from the reference date to `expiry`. Every field but the strike range is
/// presence-required (400 naming it).
table SsviSlice {
    /// Expiry date (YYYY-MM-DD), strictly after the reference date; slices
    /// must be strictly increasing.
    expiry:string (required);
    /// The forward F_ref(T) the slice is written against, > 0.
    forward:double = null;
    /// At-the-money total implied variance (sigma_ATM^2 T), > 0.
    theta:double = null;
    /// Skew, -1 < rho < 1.
    rho:double = null;
    /// psi = theta phi (the at-the-money curvature scale), > 0.
    psi:double = null;
    /// Optional strike range (absolute) a structured note holds the local
    /// vol to, exactly as `SviSlice.strike_min` / `strike_max` (and
    /// `SsviVolSpec.local_vol_strike_range`). `/calibrate-vol-surface`
    /// leaves both absent (since 0.16.9): the eSSVI formula is valid at
    /// every strike and its conditions are checked when read, so its local
    /// vol is read unclamped. No Black vol read is affected. Each > 0 and strike_min < strike_max when both
    /// are given (400 otherwise).
    strike_min:double = null;
    strike_max:double = null;
}

/// Black volatility as eSSVI slices (what `/calibrate-vol-surface` with
/// method `Ssvi` returns as `vol_surface_spec_ssvi`). Accepted wherever a
/// Black vol is referenced (`price-equity-option`, `sample-vol-surfaces`, a
/// structured note's `underlyings[].volatility_id`).
///
/// Between and beyond the slices the parameters, not the variances, are
/// interpolated: theta, psi and rho psi linear in time between two slices,
/// the first slice scaled by t / T_1 before it, and after the last slice
/// psi and rho held while theta continues the last forward variance
/// (theta_N - theta_{N-1}) / (T_N - T_{N-1}) (theta_1 / T_1 with one
/// slice). The moneyness is taken against the reference forward F_ref(t):
/// ln F_ref linear in time through ln `spot` at the reference date and ln
/// `forward` at every slice, continuing the last slope beyond. The surface
/// is defined at every time and strike (no extrapolation flag). The slices
/// must be free of static arbitrage: per slice psi (1 + |rho|) <= 4 and
/// psi^2 (1 + |rho|) <= 4 theta; between consecutive slices theta and psi
/// non-decreasing, |rho_i psi_i - rho_{i-1} psi_{i-1}| <= psi_i - psi_{i-1}
/// and one of the two sufficient conditions of Hendriks-Martini (psi /
/// theta non-increasing, or the quadratic condition); then a numeric scan
/// of Durrleman's g and of dw/dt (400 listing every violation).
///
/// A structured note simulates it as local vol with the closed-form Dupire
/// local variance of the slices (no finite differences), corrected for a
/// process forward that differs from F_ref (sticky strike):
/// sigma_loc^2 = (dw/dt + dw/dk (mu_proc - mu_ref)) / g(k, k - ln(F_proc /
/// F_ref)). The strike edges, per-expiry bands and the local vol floor of
/// the other surfaces apply to it unchanged.
///
/// `base` carries the reference date, calendar, business-day convention
/// and day counter only: `shape` must be left at its default,
/// `constant_vol` and `quote_id` absent (400 otherwise).
table SsviVolSpec {
    base:BlackVolBaseSpec;
    /// The spot the forwards were read against (the reference forward at
    /// the reference date), > 0. Presence-required.
    spot:double = null;
    /// At least one slice, strictly increasing expiries.
    slices:[SsviSlice] (required);
    /// Optional. Absent: beyond the last slice the local vol is the model's
    /// own (theta continuing the last forward variance, arbitrage free by
    /// construction). FlatLocalVol: held at T_last - 0.001 years, as for the
    /// other surfaces. FlatImpliedVol is not an eSSVI reading (the model
    /// does not extend its implied vol flat): 400. No effect on any Black
    /// vol read. `/calibrate-vol-surface` leaves it absent.
    local_vol_time_extrapolation:enums.LocalVolTimeExtrapolation = null;
    /// Optional. How the slices' strike_min / strike_max bound the local
    /// vol, as on `SviVolSpec` (absent = Global). `/calibrate-vol-surface`
    /// leaves it absent and the slices without a range (unclamped).
    local_vol_strike_range:enums.LocalVolStrikeRange = null;
}

/// Union of all volatility types.
union VolPayload { OptionletVolSpec, SwaptionVolSpec, BlackVolSpec, YoYOptionletVolSpec, SviVolSpec, SsviVolSpec }

/// Volatility surface specification referenced by id in trade requests.
table VolSurfaceSpec {
    id:string (required);
    payload:VolPayload;
}
