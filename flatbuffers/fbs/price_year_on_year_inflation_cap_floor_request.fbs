include "pricing.fbs";
include "year_on_year_inflation_cap_floor.fbs";

namespace quantra;

/// Single year-on-year inflation cap/floor pricing context with explicit
/// market-data references.
table PriceYoYInflationCapFloor {
    year_on_year_inflation_cap_floor:YoYInflationCapFloor;
    /// Reference to curve in Pricing.rates.curves used for discounting and as
    /// the nominal term structure fed to the engine.
    discounting_curve:string;
    /// Reference to curve in Pricing.inflation.inflation_curves (the YoY
    /// inflation curve the index projects off).
    inflation_curve:string;
    /// Reference to the YoYOptionletVolSpec id in
    /// Pricing.volatility.vol_surfaces.
    volatility:string;
}

/// Request to price one or more year-on-year inflation cap/floor trades.
table PriceYearOnYearInflationCapFloorRequest {
    pricing:Pricing;
    cap_floors:[PriceYoYInflationCapFloor];
}

root_type PriceYearOnYearInflationCapFloorRequest;
