include "enums.fbs";

namespace quantra;

/// Equity option pricing result.
table EquityOptionResponse {
    trade_id:string;
    npv:double;
    delta:double;
    gamma:double;
    vega:double;
    theta:double;
    rho:double;
    implied_volatility:double;
    used_spot:double;
    used_strike:double;
    used_settlement:enums.EquitySettlementType = Physical;
}

/// Response wrapper for equity option pricing.
table PriceEquityOptionResponse {
    options:[EquityOptionResponse] (required);
    /// Present only when the request set `price_only`: one NPV per trade in
    /// request order (the per-trade list is then empty).
    npvs:[double];
}

root_type PriceEquityOptionResponse;
