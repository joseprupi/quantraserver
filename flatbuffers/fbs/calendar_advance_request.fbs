include "enums.fbs";
include "calendar_override.fbs";

namespace quantra;

/// Request to advance a date by a calendar-aware period.
table CalendarAdvanceRequest {
    calendar:enums.Calendar = TARGET;
    /// Date in YYYY-MM-DD format.
    date:string (required);
    /// Number of units; can be negative for back-shift.
    tenor_number:int;
    tenor_unit:enums.TimeUnit = Days;
    convention:enums.BusinessDayConvention = Following;
    end_of_month:bool = false;
    /// Per-request holiday overrides (optional).
    calendar_overrides:[CalendarOverride];
}

root_type CalendarAdvanceRequest;
