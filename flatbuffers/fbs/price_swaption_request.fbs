include "common.fbs";
include "pricing.fbs";
include "swaption.fbs";

namespace quantra;

/// Single swaption pricing request with curve/vol/model references.
table PriceSwaption {
    swaption:Swaption;
    /// Reference to curve in pricing.rates.curves by id.
    discounting_curve:string;
    /// Reference to curve in pricing.rates.curves for forward rates by id.
    forwarding_curve:string;
    /// Reference to volatility in pricing.volatility.vol_surfaces by id.
    volatility:string;
    /// Reference to model in pricing.volatility.models by id.
    model:string;
}

/// Request to price one or more swaptions.
table PriceSwaptionRequest {
    pricing:Pricing;
    swaptions:[PriceSwaption];
}

root_type PriceSwaptionRequest;
