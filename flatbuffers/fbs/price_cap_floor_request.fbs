include "common.fbs";
include "pricing.fbs";
include "cap_floor.fbs";

namespace quantra;

/// Single cap/floor pricing request with curve/vol/model references.
table PriceCapFloor {
    cap_floor:CapFloor;
    /// Reference to curve in pricing.rates.curves by id.
    discounting_curve:string;
    /// Reference to curve in pricing.rates.curves for forward rates by id.
    forwarding_curve:string;
    /// Reference to volatility in pricing.volatility.vol_surfaces by id.
    volatility:string;
    /// Reference to model in pricing.volatility.models by id.
    model:string;
    /// Include caplet/floorlet breakdown.
    include_details:bool = false;
}

/// Request to price one or more caps/floors.
table PriceCapFloorRequest {
    pricing:Pricing;
    cap_floors:[PriceCapFloor];
    /// When true the response carries only the prices: `npvs` holds one NPV
    /// per trade in request order and the per-trade list is empty (no flows,
    /// fair values, greeks, echoes or diagnostics). The NPVs are the ones the
    /// full response reports; a request the engine refuses is refused the
    /// same way. Absent or false: the full response.
    price_only:bool = false;
}

root_type PriceCapFloorRequest;
