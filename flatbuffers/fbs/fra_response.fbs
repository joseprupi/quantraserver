namespace quantra;

/// FRA pricing response.
table FRAResponse {
    npv:double;
    /// The implied forward rate from the curve.
    forward_rate:double;
    /// Same value as npv: the settlement amount discounted on the discounting
    /// curve, not the undiscounted amount paid at settlement.
    spot_value:double;
    /// When the FRA settles.
    settlement_date:string;
}

/// Response wrapper for multiple FRAs.
table PriceFRAResponse {
    fras:[FRAResponse] (required);
    /// Present only when the request set `price_only`: one NPV per trade in
    /// request order (the per-trade list is then empty).
    npvs:[double];
}

root_type PriceFRAResponse;
