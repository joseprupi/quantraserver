include "enums.fbs";
include "schedule.fbs";

namespace quantra;

/// Fixed-rate bond instrument.
table FixedRateBond {
    settlement_days:int;
    face_amount:double;
    rate:double;
    accrual_day_counter:enums.DayCounter = null;
    payment_convention:enums.BusinessDayConvention = null;
    redemption:double;
    issue_date:string;
    schedule:Schedule;
}

root_type FixedRateBond;
