include "common.fbs";
include "pricing.fbs";
include "floating_rate_bond.fbs";
include "term_structure.fbs";

namespace quantra;

/// Single floating-rate bond pricing context.
table PriceFloatingRateBond {
    floating_rate_bond:FloatingRateBond;
    discounting_curve:string;
    forwarding_curve:string;
    coupon_pricer:string;
    yield:Yield;
}

/// Request to price one or more floating-rate bonds.
table PriceFloatingRateBondRequest {
    pricing:Pricing;
    bonds:[PriceFloatingRateBond];
    /// When true the response carries only the prices: `npvs` holds one NPV
    /// per trade in request order and the per-trade list is empty (no flows,
    /// fair values, greeks, echoes or diagnostics). The NPVs are the ones the
    /// full response reports; a request the engine refuses is refused the
    /// same way. Absent or false: the full response.
    price_only:bool = false;
}

root_type PriceFloatingRateBondRequest;
