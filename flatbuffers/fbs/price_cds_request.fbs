include "common.fbs";
include "pricing.fbs";
include "cds.fbs";

namespace quantra;

/// Single CDS pricing request with curve/credit/model references.
table PriceCDS {
    cds:CDS;
    /// Reference to yield curve in pricing.rates.curves by id.
    discounting_curve:string;
    /// Reference to credit curve in pricing.credit.credit_curves by id.
    credit_curve_id:string;
    /// Reference to model in pricing.volatility.models by id.
    model:string;
}

/// Batch CDS pricing request.
table PriceCDSRequest {
    pricing:Pricing;
    cds_list:[PriceCDS];
}

root_type PriceCDSRequest;
