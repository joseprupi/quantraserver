include "pricing.fbs";
include "equity_option.fbs";

namespace quantra;

/// Single equity option pricing request with curve/vol/model references.
table PriceEquityOption {
    option:EquityOption;
    /// Reference to risk-free discounting curve in pricing.rates.curves by id.
    discounting_curve:string;
    /// Reference to volatility in pricing.volatility.vol_surfaces by id (a
    /// BlackVolSpec, SviVolSpec or SsviVolSpec). A plain vanilla payoff prices
    /// on any of them. A cash-or-nothing or asset-or-nothing payoff and a
    /// barrier are priced with one vol read at the strike, so they require a
    /// vol that does not depend on strike (a Constant or AtmMatrix2D
    /// BlackVolSpec); a strike x expiry grid, SVI or eSSVI slices are a 400.
    volatility:string;
    /// Reference to model in pricing.volatility.models by id.
    model:string;
}

/// Request to price one or more equity options.
table PriceEquityOptionRequest {
    pricing:Pricing;
    options:[PriceEquityOption];
    /// When true the response carries only the prices: `npvs` holds one NPV
    /// per trade in request order and the per-trade list is empty (no flows,
    /// fair values, greeks, echoes or diagnostics). The NPVs are the ones the
    /// full response reports; a request the engine refuses is refused the
    /// same way. Absent or false: the full response.
    price_only:bool = false;
}

root_type PriceEquityOptionRequest;
