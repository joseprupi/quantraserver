include "enums.fbs";
include "common.fbs";

namespace quantra;

/// Calibration-specific diagnostics. Populated only for SABR surfaces whose
/// kind is SabrCalibrate. For SabrParams surfaces (and other kinds in future
/// extensions) this sub-block is absent on the parent SwaptionVolDiagnostics.
table SabrCalibrationDiagnostics {
    /// Root-mean-square fit error per (expiry, tenor) node, row-major nExp*nTen.
    per_node_rmse:[double];
    /// Worst single-strike absolute error per (expiry, tenor) node, row-major nExp*nTen.
    per_node_max_abs_error:[double];
    /// Aggregate RMSE across the entire cube.
    overall_rmse:double;
    /// True iff every node converged to a stationary point (i.e., end criteria
    /// is not None and not MaxIterations on any node).
    converged:bool;
    /// Iteration count per node. Sentinel -1 indicates "not exposed by the
    /// optimizer" — current QuantLib (1.41) does not expose this publicly from
    /// the SABR interpolator, so v1 always emits -1. Field is retained for
    /// schema forward-compatibility.
    iterations_per_node:[int];
    /// Strike spreads used in calibration (rate units, e.g. -0.02 = -200bp).
    /// Same vector applied at every (expiry, tenor) node.
    strikes:[double];
    /// Per-strike fit error (fitted - market) for each (expiry, tenor, strike).
    /// Row-major nExp*nTen*nStrikes.
    per_strike_fit_error:[double];
}

/// Diagnostics block describing one swaption vol surface. Emitted opt-in by
/// /sample-vol-surfaces and /price-swaption when include_diagnostics=true, and
/// reused as the response body for the standalone /calibrate-swaption-vol
/// endpoint.
table SwaptionVolDiagnostics {
    /// Matches Pricing.volatility.vol_surfaces[].id.
    vol_id:string (required);
    /// Resolved swaption vol kind for the surface.
    kind:enums.SwaptionVolKind;

    /// Per-node grid axes, mirroring the surface's pillars.
    expiries:[Period];
    tenors:[Period];
    n_expiries:int;
    n_tenors:int;

    /// Per-node forwards F(expiry, tenor), populated when handle is built.
    /// Row-major nExp*nTen.
    forward_per_node:[double];
    /// Per-node ATM vols sigma(F) evaluated via Hagan. Row-major nExp*nTen.
    atm_vol_per_node:[double];
    /// Time-to-expiry in years for each node. Row-major nExp*nTen.
    time_to_expiry_per_node:[double];

    /// SABR parameters in effect at each node. For SabrParams these are the
    /// user-supplied values; for SabrCalibrate these are calibrator output.
    /// Row-major nExp*nTen, schema field order alpha, beta, rho, nu.
    alpha_per_node:[double];
    beta_per_node:[double];
    rho_per_node:[double];
    nu_per_node:[double];

    /// Calibration sub-block. Present only for SabrCalibrate; absent for
    /// SabrParams (and other kinds in future extensions).
    calibration:SabrCalibrationDiagnostics;

    /// Validation warnings. Empty when fit is healthy.
    warnings:[string];
}

/// One calibrated eSSVI slice of /calibrate-equity-vol. Vols and errors are decimals
/// (0.01 = one vol point).
table EquityVolSliceDiagnostics {
    expiry_date:string (required);
    /// Year fraction from the reference date (surface day counter).
    time:double;
    /// Forward used for the fit: put-call parity when calls and puts exist at >= 2 common
    /// strikes, else the curve forward (an expiry without parity pairs needs a dividend curve).
    pcp_forward:double;
    /// Forward from the spot, dividend and discount curves. Null when the surface has no
    /// dividend curve.
    curve_forward:double = null;
    /// -ln(pcp_forward Dr(T) / S0) / T.
    implied_dividend_yield:double;
    /// Anchor quote (closest to the money) log-moneyness and total variance, after clamping.
    anchor_k:double;
    anchor_theta:double;
    /// True when the anchor total variance was raised to keep the calendar condition feasible.
    anchor_clamped:bool;
    used_quotes:int;
    excluded_quotes:int;
    /// Root-mean-square and max absolute error of the used quotes, decimal vol.
    rmse:double;
    max_abs_error:double;
    /// Constraint margins, rhs - lhs, >= 0 when satisfied (see ssvi_calibrator.h).
    margin_butterfly_psi:double;
    margin_butterfly_psi2:double;
    /// Calendar margins versus the previous slice; absent on the first slice.
    margin_calendar_theta:double = null;
    margin_calendar_psi:double = null;
    margin_calendar_a:double = null;
    /// Put-call pairs (common strikes) behind pcp_forward, after outlier rejection; 0 when the
    /// forward is the curve forward.
    parity_pairs_used:uint;
    /// Pairs dropped as outliers: further than max(5 * 1.4826 MAD, 1e-4 pcp_forward) from the
    /// median pair forward (only with >= 3 pairs). Both quotes are excluded as "parity_outlier".
    parity_pairs_rejected:uint;
}

/// One input quote of /calibrate-equity-vol with its fit residual.
table EquityVolQuoteDiagnostics {
    expiry_date:string (required);
    strike:double;
    option_type:enums.EquityOptionType;
    /// Implied vol of the quote (decimal); absent when it could not be solved (unused quotes).
    market_vol:double = null;
    model_vol:double;
    /// model_vol - market_vol, decimal vol; absent with market_vol.
    residual:double = null;
    /// The user weight of the quote.
    weight:double;
    used:bool;
    /// Empty for used quotes. Otherwise the first that applies:
    ///   price_outside_bounds      price outside (intrinsic, D F) for a call or (intrinsic, D K)
    ///                             for a put at the slice forward F;
    ///   parity_outlier            one of a put-call pair rejected from the parity forward;
    ///   implied_vol_not_solved    the implied-vol solve failed;
    ///   in_the_money_side         the out-of-the-money quote of the same strike is used instead;
    ///   max_abs_log_moneyness     |ln(K / F)| beyond SsviFitSpec.max_abs_log_moneyness;
    ///   implied_vol_not_positive  implied total variance is not > 0;
    ///   ask_not_above_bid         BidAsk weighting and ask <= bid.
    /// A slice needs at least 3 used quotes, otherwise the request is rejected.
    exclusion_reason:string;
}

/// Diagnostics block of /calibrate-equity-vol.
table EquityVolDiagnostics {
    slices:[EquityVolSliceDiagnostics];
    quotes:[EquityVolQuoteDiagnostics];
    /// Quotes dropped for |k| > max_abs_log_moneyness.
    excluded_by_moneyness:int;
    overall_rmse:double;
    overall_max_abs_error:double;
    /// Arbitrage violations found after the fit (empty on success).
    violations:[string];
    /// Minimum of the Durrleman function g(k, k) and of dw/dt over the scan grid, with the
    /// (t, k) where they occur.
    scan_min_g:double;
    scan_min_g_t:double;
    scan_min_g_k:double;
    scan_min_w_t:double;
    scan_min_w_t_t:double;
    scan_min_w_t_k:double;
}
