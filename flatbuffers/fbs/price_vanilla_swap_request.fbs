include "common.fbs";
include "pricing.fbs";
include "vanilla_swap.fbs";

namespace quantra;

/// One vanilla swap to price. The legs name their own discounting and
/// forwarding curves (`SwapLeg`); every reference is by id into `pricing`.
/// The NPV is reported in the legs' currency.
table PriceVanillaSwap {
    /// The swap. Required.
    vanilla_swap:VanillaSwap (required);
}

/// Request to price one or more vanilla swaps against one market.
table PriceVanillaSwapRequest {
    pricing:Pricing;
    swaps:[PriceVanillaSwap];
    /// When true every response row lists each leg's future flows (coupons
    /// and notional exchanges) in payment order.
    include_flows:bool = false;
    /// When true the response carries only the prices: `npvs` holds one NPV
    /// per trade in request order and the per-trade list is empty (no flows,
    /// fair values, greeks, echoes or diagnostics). The NPVs are the ones the
    /// full response reports; a request the engine refuses is refused the
    /// same way. Absent or false: the full response.
    price_only:bool = false;
}

root_type PriceVanillaSwapRequest;
