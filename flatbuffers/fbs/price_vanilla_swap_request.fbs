include "common.fbs";
include "pricing.fbs";
include "vanilla_swap.fbs";

namespace quantra;

/// Single vanilla swap pricing context with curve references.
table PriceVanillaSwap {
    vanilla_swap:VanillaSwap;
    /// Reference to curve in pricing.rates.curves by id.
    discounting_curve:string;
    /// Reference to curve in pricing.rates.curves for forward rates by id.
    forwarding_curve:string;
}

/// Request to price one or more vanilla swaps.
table PriceVanillaSwapRequest {
    pricing:Pricing;
    swaps:[PriceVanillaSwap];
    /// Include detailed cashflows in response.
    include_flows:bool = false;
}

root_type PriceVanillaSwapRequest;
