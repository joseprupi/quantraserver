namespace quantra;

/// Individual caplet/floorlet detail.
table CapFloorLet {
    payment_date:string;
    accrual_start_date:string;
    accrual_end_date:string;
    fixing_date:string;
    strike:double;
    forward_rate:double;
    discount:double;
    /// Individual caplet/floorlet price.
    price:double;
}

/// Cap/Floor pricing response.
table CapFloorResponse {
    npv:double;
    /// At-the-money rate.
    atm_rate:double;
    /// Implied volatility if priced from market price.
    implied_volatility:double;
    cap_floor_lets:[CapFloorLet];
}

/// Response wrapper for multiple caps/floors.
table PriceCapFloorResponse {
    cap_floors:[CapFloorResponse];
}

root_type PriceCapFloorResponse;
