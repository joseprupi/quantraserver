include "enums.fbs";
include "volatility.fbs";
include "option_quotes.fbs";
include "calibrate_implied_forwards_response.fbs";

namespace quantra;

/// Forward and implied discount factor used at one fitted expiry (from the
/// request's `forwards` or from the internal implied-forward fit).
table VolSurfaceForward {
    expiry:string (required);
    /// Act/365F year fraction from the as-of date.
    time:double;
    forward:double;
    implied_discount_factor:double;
}

/// Raw SVI parameters of one slice: total variance
/// w(k) = a + b (rho (k - m) + sqrt((k - m)^2 + sigma^2)), k = ln(K / F).
table SviParameters {
    a:double;
    b:double;
    sigma:double;
    rho:double;
    m:double;
}

/// eSSVI parameters of one slice (see `SsviSlice`): at-the-money total
/// variance theta, skew rho, curvature scale psi = theta phi.
table SsviParameters {
    theta:double;
    rho:double;
    psi:double;
}

/// Per-expiry report. Every sheet expiry appears once, in date order.
table VolSurfaceExpiryReport {
    expiry:string (required);
    time:double;
    /// True iff the expiry entered the fit.
    usable:bool;
    /// Why not (absent when `usable`).
    dropped_reason:string;
    forward:double = null;
    implied_discount_factor:double = null;
    /// Quotes whose out-of-the-money mid gave an implied vol and entered the fit.
    quotes_used:uint;
    quotes_dropped:uint;
    dropped:[DroppedQuote];
    /// `SviPerExpiry` only.
    svi:SviParameters;
    /// `SviPerExpiry` only: what the fit found (Durrleman's g(k) < 0 or a
    /// wing steeper than Lee's bound on the independent fit) and did ("none",
    /// "refit with penalty: min g ... -> ...").
    butterfly_action:string;
    /// `SviPerExpiry` only, every fitted expiry after the first: whether the
    /// calendar penalty refit of the sequential fit acted on this slice.
    calendar_refit:bool;
    /// Largest change in vol the calendar refit made over the slice's quoted
    /// strikes (absent when it did not act).
    calendar_refit_max_vol_shift:double = null;
    /// What the sequential fit found and did against the previous slice.
    calendar_fit_action:string;
    /// Grid strikes at which total variance was below the previous grid
    /// expiry's (before the clip).
    calendar_violations:uint;
    /// Largest change in vol applied by the calendar clip (vol units).
    calendar_max_clip_vol:double = null;
    calendar_action:string;
    /// `Ssvi` only: the fitted slice.
    ssvi:SsviParameters;
    /// `Ssvi` only: the anchor of the slice, the used quote nearest the
    /// money (log-moneyness ln(K / F) and the total variance the slice
    /// reproduces there, after a clamp).
    ssvi_anchor_k:double = null;
    ssvi_anchor_total_variance:double = null;
    /// `Ssvi` only: true when the anchor's total variance was raised to
    /// keep the calendar conditions feasible against the previous slice.
    ssvi_anchor_clamped:bool;
    /// `AndreasenHuge` only: grid strikes where the model's out-of-the-money
    /// price is below 1e-4 of the spot (finite-difference noise would move
    /// the vol by more than a tenth of a point) or its inversion failed,
    /// filled flat from the nearest inverted strike of the expiry.
    grid_points_filled:uint;
}

/// Response of `/calibrate-vol-surface`.
table CalibrateVolSurfaceResponse {
    sheet_id:string (required);
    underlying_id:string (required);
    spot:double;
    method:enums.VolSurfaceFitMethod = null;
    /// "request" when `forwards` was given, "fitted" when the implied-forward
    /// fit was run here.
    forwards_source:string (required);
    /// The quote filter applied (request values or the defaults).
    filter:QuoteFilter (required);
    /// Forwards used, fitted expiries only, date order.
    forwards:[VolSurfaceForward] (required);
    /// Per-expiry report, every sheet expiry, date order.
    expiries:[VolSurfaceExpiryReport] (required);
    /// The moneyness axis applied and the absolute strikes it became.
    strikes_as_moneyness:[double] (required);
    grid_strikes:[double] (required);
    /// Grid expiry dates (YYYY-MM-DD).
    grid_expiries:[string] (required);
    /// Complete `VolSurfaceSpec` (BlackVolSpec, shape SmileCube3D,
    /// NullCalendar / Unadjusted / Actual365Fixed, expiries as calendar-day
    /// periods from the as-of date, absolute strikes, `surface_interpolator`
    /// CubicStrikeLinearTime, allow_extrapolation true) under the request's
    /// `vol_surface_id`.
    vol_surface_spec:VolSurfaceSpec (required);
    /// `SviPerExpiry` only: the same surface as its fitted slices, an
    /// `SviVolSpec` payload (one `SviSlice` per fitted expiry with the
    /// forward used and the final a, b, sigma, rho, m; same base and id as
    /// `vol_surface_spec`, allow_extrapolation true), ready to paste in
    /// place of the grid. The slices are the sequential fit's (after the
    /// calendar and butterfly refits), so they are ordered in time like the
    /// grid; the grid's last-resort clip applies to the grid only.
    vol_surface_spec_svi:VolSurfaceSpec;
    /// Present iff `vol_surface_spec_svi` is absent: why (the other
    /// methods have no SVI slice parameters).
    vol_surface_spec_svi_note:string;
    /// `Ssvi` only: the same surface as its fitted eSSVI slices, an
    /// `SsviVolSpec` payload (one `SsviSlice` per fitted expiry with the
    /// forward used, theta, rho and psi, no strike_min / strike_max: the
    /// local vol is read unclamped; `spot` the sheet's spot; base and id as
    /// `vol_surface_spec`; local_vol_strike_range and
    /// local_vol_time_extrapolation absent: the model's own continuation).
    /// A structured note simulates it with the closed-form local vol.
    vol_surface_spec_ssvi:VolSurfaceSpec;
    /// Whether the Dupire local vol of `vol_surface_spec`, read as a
    /// structured note reads it on the sheet's forwards, evaluates at every
    /// point of the scan `/validate-vol-surface` runs (`LocalVolCheck`):
    /// the surface can be simulated as local vol. The full check, the fit
    /// statistics and the Monte Carlo repricing are `/validate-vol-surface`.
    arbitrage_free:bool;
    /// The same for `vol_surface_spec_svi` (`SviPerExpiry` only).
    arbitrage_free_svi:bool = null;
    /// The same for `vol_surface_spec_ssvi` (`Ssvi` only; the closed-form
    /// local vol, plus the slices' closed-form conditions).
    arbitrage_free_ssvi:bool = null;
    /// `SviPerExpiry` only: what the local vol check of the SVI payload made
    /// the fit do: "none", or the refit passes (the flagged slices refitted
    /// with a larger calendar margin and butterfly weight, at most 3).
    svi_local_vol_refit_action:string;
}

root_type CalibrateVolSurfaceResponse;
