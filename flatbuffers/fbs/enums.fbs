namespace quantra.enums;

/// Day count conventions for accrual and discounting.
enum DayCounter : byte {
    Actual360 = 0,
    Actual365Fixed = 1,
    Actual365NoLeap = 2,
    ActualActual = 3,
    ActualActualISMA = 4,
    ActualActualBond = 5,
    ActualActualISDA = 6,
    ActualActualHistorical = 7,
    ActualActual365 = 8,
    ActualActualAFB = 9,
    ActualActualEuro = 10,
    Business252 = 11,
    One = 12,
    Simple = 13,
    Thirty360 = 14,
}

/// Curve interpolation methods.
enum Interpolator : byte {
    BackwardFlat = 0,
    ForwardFlat = 1,
    Linear = 2,
    LogCubic = 3,
    LogLinear = 4,
}

/// Interpolation of a strike x expiry Black surface (`BlackVolSpec`
/// `SmileCube3D` / `SurfaceFromPrices`), always in total variance.
///   Bilinear: QuantLib `BlackVarianceSurface`, bilinear in (strike, time).
///     The variance is linear between two grid strikes, so a Dupire local
///     vol derived from it has no smile curvature inside a cell (it does not
///     reprice the quotes through a Monte Carlo; see docs/http-api.md).
///   Bicubic: QuantLib `BicubicSpline` on the whole grid (a spline in time
///     too, through the zero-variance column at t = 0: the short end is
///     distorted; costly per evaluation).
///   CubicStrikeLinearTime: per expiry a natural cubic spline of total
///     variance in log-strike (C2, so the local vol is continuous), linear
///     in total variance between expiries at fixed strike, constant beyond
///     the first and last strike, flat implied vol beyond the last expiry.
///     What `/calibrate-vol-surface` returned before 0.16.10.
///   CubicStrikeLinearTimeForwardMoneyness (since 0.16.10): the same rows,
///     linear in total variance between expiries at fixed forward moneyness
///     k = ln(K / F(t)): w(t, K) = (1 - l) w_i(F_i e^k) + l w_{i+1}(F_{i+1} e^k),
///     l = (t - T_i) / (T_{i+1} - T_i), F_i = F(T_i) (and w_1(F_1 e^k) t / T_1
///     before the first expiry, w_n(F_n e^k) t / T_n after the last). This
///     is the reading a Dupire local vol needs: QuantLib differentiates the
///     variance in time along the forward, where k is fixed. F(t) comes from
///     the spec's `expiry_forwards` (ln F linear in time through `spot` when
///     given and the forwards, the last slope continued beyond) or, without
///     them, from its spot, dividend and discount inputs (spot D_q / D_r).
///     A structured note's local vol reads it against F(t) reshaped between
///     expiries like the note's own forward (equal to F_i at every expiry).
///     What `/calibrate-vol-surface` returns.
///   A BlackVolSpec without `surface_interpolator` reads CubicStrikeLinearTime.
enum SurfaceInterpolator2D : byte {
    Bilinear = 0,
    Bicubic = 1,
    CubicStrikeLinearTime = 2,
    CubicStrikeLinearTimeForwardMoneyness = 3
}

/// How an `SviVolSpec` interpolates between its slices.
///   LinearTotalVariance: at a fixed strike, w(t, K) linear in t between the
///     bracketing slices' total variances at K; before the first slice
///     w(T1, K) t / T1 and after the last w(Tn, K) t / Tn (flat implied vol
///     on both ends). The default (absent).
///   LinearTotalVarianceForwardMoneyness (since 0.16.10): at a fixed forward
///     moneyness k = ln(K / F(t)): w(t, K) = (1 - l) w_i(k) + l w_{i+1}(k),
///     l = (t - T_i) / (T_{i+1} - T_i), each slice read at its own k (SVI
///     slices are written in k about their `forward`); w_1(k) t / T1 before
///     the first slice, w_n(k) t / Tn after the last. F(t): ln F linear in
///     time through the payload's `spot` at the reference date (when given)
///     and the slices' forwards, the last slope continued beyond the last
///     slice; without `spot` the first slope is continued back (one slice:
///     F constant). Slices ordered at fixed k then give a non-negative
///     Dupire time derivative along every forward line with that drift; a
///     structured note's local vol reads it against F(t) reshaped between
///     expiries like the note's own forward (equal to the slice forwards at
///     the expiries). What `/calibrate-vol-surface` returns.
enum SviTimeInterpolation : byte {
    LinearTotalVariance = 0,
    LinearTotalVarianceForwardMoneyness = 1
}

/// How the Dupire local vol that a structured note simulates on a
/// strike-dependent Black surface (a strike x expiry grid or an SviVolSpec)
/// is extended in time beyond the surface's last expiry.
///   FlatImpliedVol: the local vol of the surface's own extension, a flat
///     implied vol in time (w(t, K) = w(T, K) t / T). With a skew it turns
///     negative at long horizons (the note is then a 400).
///   FlatLocalVol: the local vol is held time-homogeneous: every time after
///     the last expiry reads the local vol at T - 0.001 years (T the last
///     expiry's year fraction), at the simulated level. What a BlackVolSpec
///     or an SviVolSpec without the field reads.
/// The Black vol itself (vanilla pricing, diagnostics) is the flat implied
/// vol beyond the last expiry under both.
enum LocalVolTimeExtrapolation : byte {
    FlatImpliedVol = 0,
    FlatLocalVol = 1
}

/// Strike range a structured note holds the Dupire local vol of an
/// SviVolSpec to (a simulated level beyond it reads the local vol at the
/// edge).
///   Global: [min of every slice's strike_min, max of every slice's
///     strike_max], at every time.
///   PerExpiry: at time t, [strike_min, strike_max] of the first slice
///     whose expiry is at or after t (the last slice's beyond the last
///     expiry), intersected, within 2e-4 years of an expiry, with the range
///     of the interval on the other side of it: a read there evaluates both
///     intervals inside its time stencil, so a step landing on an expiry
///     never reads the next slice beyond the next range (since 0.16.9; if
///     the two ranges are disjoint, the first one alone). Every slice must
///     carry both.
enum LocalVolStrikeRange : byte {
    Global = 0,
    PerExpiry = 1
}

