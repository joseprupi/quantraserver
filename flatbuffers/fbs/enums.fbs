/// CDS pricing engine type.
enum CdsEngineType : byte {
    MidPoint = 0,
    ISDA = 1
}

/// CDS helper model convention.
enum CdsHelperModel : byte {
    MidPoint = 0,
    ISDA = 1
}

/// CDS market quote type.
enum CdsQuoteType : byte {
    ParSpread = 0,
    Upfront = 1
}

/// CDS ISDA numerical fix convention.
enum CdsIsdaNumericalFix : byte {
    None = 0,
    Taylor = 1
}

/// CDS ISDA accrual bias convention.
enum CdsIsdaAccrualBias : byte {
    HalfDayBias = 0,
    NoBias = 1
}

/// CDS ISDA forwards-in-coupon-period convention.
enum CdsIsdaForwardsInCouponPeriod : byte {
    Flat = 0,
    Piecewise = 1
}

/// Compounding convention for rates.
enum Compounding : byte {
    Compounded = 0,
    Continuous = 1,
    Simple = 2,
    SimpleThenCompounded = 3
}

/// Overnight rate averaging method.
enum RateAveragingType : byte {
    Compound = 0,
    Simple = 1
}

/// Swap direction: payer (pay fixed, receive floating) or receiver (receive fixed, pay floating).
enum SwapType : byte {
    Payer = 0,
    Receiver = 1
}

/// Side of one swap leg from the reported party's view (`SwapLeg.pay_receive`):
/// `Pay` = the party pays the leg's coupons (and, with the exchanges on, receives
/// the initial notional and pays the final one), `Receive` the opposite.
enum PayReceive : byte {
    Pay = 0,
    Receive = 1
}

/// FRA position: long (pay fixed, receive floating: gains when the forward rate
/// rises above the strike) or short (receive fixed, pay floating).
enum FRAType : byte {
    Long = 0,
    Short = 1
}

/// Cap/Floor instrument type: cap, floor, or collar.
enum CapFloorType : byte {
    Cap = 0,
    Floor = 1,
    Collar = 2
}

/// Callable/puttable bond option side attached to a call-schedule entry:
/// Call (issuer may redeem the bond early) or Put (holder may sell it back
/// early). Presence-required on CallabilityEntry — there is no
/// alphabetical-0 default.
enum CallabilityType : byte {
    Call = 0,
    Put = 1
}

/// Fit method of `/calibrate-vol-surface`: Andreasen-Huge local-vol
/// interpolation (arbitrage-free by construction, QuantLib
/// AndreasenHugeVolatilityInterpl), one SVI slice per expiry with
/// butterfly and calendar checks, or eSSVI slices.
enum VolSurfaceFitMethod : byte {
    AndreasenHuge = 0,
    SviPerExpiry = 1,
    /// eSSVI slices fitted short to long, free of butterfly and calendar
    /// arbitrage by construction (`CalibrateVolSurfaceRequest.ssvi`).
    Ssvi = 2
}

/// Quote weighting of a volatility surface fit
/// (`CalibrateVolSurfaceRequest.weighting`). The fit minimises, over the
/// used quotes of an expiry,
///
///     sum_i weight_i (model_vol_i - market_vol_i)^2.
///
///   Uniform: weight 1.
///   Vega: the Black vega of the quote at its market vol.
///   BidAsk: 1 / (bid-ask spread in vol units)^2, the spread of a price
///     quote being (ask - bid) / vega.
enum QuoteWeighting : byte {
    Uniform = 0,
    Vega = 1,
    BidAsk = 2
}

/// Exercise style: European (at expiry only), Bermudan (on specific dates), or American (any time).
/// Used by swaptions and by `OptionQuoteSheet.option_style`.
enum ExerciseType : byte {
    European = 0,
    Bermudan = 1,
    American = 2
}

/// Swaption settlement: physical (deliver swap) or cash.
enum SettlementType : byte {
    Physical = 0,
    Cash = 1
}

/// Swaption settlement method when settlement_type is Cash.
enum SettlementMethod : byte {
    PhysicalOTC = 0,
    PhysicalCleared = 1,
    CollateralizedCashPrice = 2,
    ParYieldCurve = 3
}

/// CDS protection side: buyer or seller.
enum ProtectionSide : byte {
    Buyer = 0,
    Seller = 1
}

/// Volatility quote type: Normal, Lognormal, or ShiftedLognormal.
enum VolatilityType : byte {
    Normal = 0,
    Lognormal = 1,
    ShiftedLognormal = 2
}

/// Volatility surface shape (dimensions and structure).
enum VolSurfaceShape : byte {
    Constant = 0,
    AtmMatrix2D = 1,
    SmileCube3D = 2,
    SurfaceFromPrices = 3,
    SabrParams = 4,
    SabrCalibrate = 5,
    /// The shape an `SviVolSpec` payload reports (`vol_shape` echoes); not
    /// a `BlackVolSpec.base.shape` value (400).
    SviSlices = 6,
    /// The shape an `SsviVolSpec` payload reports; not a
    /// `BlackVolSpec.base.shape` value (400).
    SsviSlices = 7
}

/// Pricing formula (engine) for year-on-year inflation caps/floors. Selects the
/// QuantLib engine over the same constant YoY optionlet vol surface: Black
/// (lognormal), UnitDisplacedBlack (unit-displaced lognormal), or Bachelier
/// (normal). This is presence-required on YoYOptionletVolSpec — there is no
/// alphabetical-0 default.
enum YoYInflationCapFloorEngineType : byte {
    Black = 0,
    UnitDisplacedBlack = 1,
    Bachelier = 2
}

/// Swaption volatility surface shape.
enum SwaptionVolKind : byte {
    Constant = 0,
    AtmMatrix2D = 1,
    SmileCube3D = 2,
    SabrParams = 3,
    SabrCalibrate = 4
}

/// Swaption strike convention: absolute or spread from ATM.
enum SwaptionStrikeKind : byte {
    Absolute = 0,
    SpreadFromATM = 1
}

/// Inflation curve kind (zero-coupon or year-on-year).
enum InflationCurveKind : byte {
    ZeroInflation = 0,
    YoYInflation = 1
}

/// Inflation curve output measure for sampling endpoints.
enum InflationCurveMeasure : byte {
    ZeroRate = 0,
    YoYRate = 1
}

/// CPI fixing interpolation convention used by QuantLib inflation helpers.
enum CPIInterpolationType : byte {
    AsIndex = 0,
    Flat = 1,
    Linear = 2
}

/// Bond quote cleanliness used by CPI bond bootstrap helpers.
enum BondPriceType : byte {
    Clean = 0,
    Dirty = 1
}

/// Interest rate model type.
enum IrModelType : byte {
    Black = 0,
    ShiftedBlack = 1,
    Bachelier = 2,
    HullWhiteLattice = 3
}

/// Model parameter source: explicit values or calibrate from helpers.
enum ModelParamMode : byte {
    Explicit = 0,
    Calibrate = 1
}

/// CMS coupon pricer selection.
enum CmsPricerType : byte {
    LinearTsr = 0,
    HaganAnalytic = 1,
    HaganNumeric = 2
}

/// Yield-curve model used by CMS Hagan-family pricers.
enum CmsYieldCurveModel : byte {
    Standard = 0,
    ExactYield = 1,
    ParallelShifts = 2,
    NonParallelShifts = 3
}

/// Equity option model type.
enum EquityModelType : byte {
    BlackScholesAnalytic = 0,
    BinomialCRR = 1
}

/// Equity option payoff type.
enum EquityOptionType : byte {
    Call = 0,
    Put = 1
}

/// Equity option settlement type.
enum EquitySettlementType : byte {
    Physical = 0,
    Cash = 1
}

/// Barrier direction/style for barrier options.
enum EquityBarrierType : byte {
    DownIn = 0,
    UpIn = 1,
    DownOut = 2,
    UpOut = 3
}

/// Barrier monitoring type.
enum EquityBarrierMonitoring : byte {
    Continuous = 0,
    Discrete = 1
}

/// Direction of the base-currency notional of an FX forward, seen from the
/// party whose NPV is reported. BuyBase: that party receives the base-currency
/// notional at maturity and pays base_notional x forward_rate units of the
/// quote currency. SellBase: the opposite. A positive NPV is in favour of that
/// party.
enum FxDirection : byte {
    BuyBase = 0,
    SellBase = 1
}

/// Kind of a swap-leg cash flow. Coupon: an interest payment (fixed or
/// floating). NotionalExchange: a principal flow of a cross-currency swap
/// (the initial exchange at the leg's start date, the final one with the last
/// coupon); it carries no accrual or rate fields.
enum SwapFlowKind : byte {
    Coupon = 0,
    NotionalExchange = 1
}

/// How the performances of a basket's underlyings (each S_i(t) / initial
/// level_i) are reduced to the single number the structured-note triggers
/// are tested against. WorstOf: the minimum (every index must be at or above
/// the trigger). BestOf: the maximum. Average: the equally-weighted mean.
enum BasketPerformanceRule : byte {
    WorstOf = 0,
    BestOf = 1,
    Average = 2
}

/// When a structured note's capital-protection barrier is tested.
/// European: on the final observation date only. DailyClose: on every
/// business-day close from the strike date to the final observation
/// (simulated on the fine time grid; past closes are not supplied in
/// 0.12.0, so a seasoned note with DailyClose monitoring is a 400).
enum CapitalBarrierMonitoring : byte {
    European = 0,
    DailyClose = 1
}

/// Random-number source of a Monte Carlo simulation. Sobol: low-discrepancy
/// Sobol sequence (QuantLib SobolRsg, Jaeckel direction integers; with
/// `brownian_bridge` the SobolBrownianBridgeRsg ordering). PseudoRandom:
/// Mersenne Twister with inverse-cumulative Gaussian draws.
enum RandomSequence : byte {
    Sobol = 0,
    PseudoRandom = 1
}

/// Where a structured note stands at the valuation date once the past
/// observation events have been resolved from `historical_levels`.
/// Alive: at least one event is still to be observed and the note is
/// simulated. Called: a past observation triggered the autocall; nothing is
/// simulated, the NPV is the discounted call payment when its payment date
/// is after the valuation date and 0 otherwise. Matured: the final
/// observation is in the past; the NPV is the discounted redemption (plus
/// any final coupon) when its payment date is after the valuation date and
/// 0 otherwise.
enum StructuredNoteStatus : byte {
    Alive = 0,
    Called = 1,
    Matured = 2
}

/// How a price history is turned into returns by `/calibrate-correlation`.
/// Log: ln(P_t / P_{t-1}). Simple: P_t / P_{t-1} - 1.
enum ReturnType : byte {
    Log = 0,
    Simple = 1
}

/// Which of the aligned observations `/calibrate-correlation` differences.
/// Daily: every date common to all series. Weekly: every fifth common
/// observation, counted back from the last one (so the most recent close is
/// always used); the returns are then five-observation returns.
enum ReturnFrequency : byte {
    Daily = 0,
    Weekly = 1
}

/// Shrinkage of the sample correlation toward the constant-correlation
/// target (every off-diagonal entry equal to the average sample
/// correlation). None: the sample correlation. LedoitWolf: the intensity of
/// Ledoit and Wolf (2004), "Honey, I shrunk the sample covariance matrix",
/// clipped to [0, 1]. Fixed: the intensity given in
/// `shrinkage_intensity`.
enum CorrelationShrinkage : byte {
    None = 0,
    LedoitWolf = 1,
    Fixed = 2
}
