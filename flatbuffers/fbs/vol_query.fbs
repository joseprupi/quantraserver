include "common.fbs";
include "curve_query.fbs";
include "enums.fbs";

namespace quantra;

/// Volatility surface type: Swaption, Optionlet, or EquityBlack.
enum VolSurfaceType : byte {
    Swaption = 0,
    Optionlet = 1,
    EquityBlack = 2
}

/// Strike axis convention.
enum VolStrikeAxis : byte {
    AbsoluteStrike = 0,
    SpreadFromATM = 1
}

/// Output structure for vol sampling.
enum VolOutputMode : byte {
    Cube = 0,
    SmileSlice = 1,
    TermSlice = 2,
    ExpirySlice = 3
}

/// Strike grid for vol surface sampling.
table StrikeGrid {
    axis:VolStrikeAxis = AbsoluteStrike;
    /// If axis=SpreadFromATM these are spreads.
    strikes:[double] (required);
}

/// Volatility surface query specification.
table VolQuerySpec {
    /// References Pricing.vol_surfaces[].id.
    vol_id:string (required);
    surface_type:VolSurfaceType = Swaption;
    expiry_grid:DateGridSpec (required);
    /// Required for swaption, ignored for optionlet.
    tenor_grid:DateGridSpec;
    strike_grid:StrikeGrid (required);
    options:QueryOptions;
    output_mode:VolOutputMode = Cube;
    /// Optional override; must match surface swap_index_id if provided.
    swap_index_id:string;

    /// Slice selectors (only used by slice modes). -1 means "not set".
    slice_expiry_index:int = -1;
    slice_tenor_index:int = -1;
    slice_strike:double;
    /// Strict mode requires true for slice modes using slice_strike.
    slice_strike_is_set:bool = false;

    /// Required for SpreadFromATM swaption surfaces to compute ATM forwards.
    discounting_curve_id:string;
    forwarding_curve_id:string;
}

/// Expiry date semantics for vol sampling.
enum ExpiryKind : byte {
    ExerciseDate = 0,
    GridDate = 1
}

/// Sampled volatility surface output.
table VolSurfaceSample {
    vol_id:string (required);
    /// Vol surface reference date.
    reference_date:string;
    ql_vol_type:enums.VolatilityType;
    requested_strike_axis:VolStrikeAxis;
    canonical_strike_kind:enums.SwaptionStrikeKind;
    allow_extrapolation_used:bool;
    calendar_used:enums.Calendar;
    business_day_convention_used:enums.BusinessDayConvention;

    /// Swaption: ExerciseDate and expiries are effective exercise dates. Optionlet: GridDate and expiries are grid dates.
    expiry_kind:ExpiryKind = GridDate;
    /// Sampled expiry dates (ISO).
    expiries:[string];
    /// Optional grid points after grid conventions.
    requested_expiry_grid_points:[string];
    tenors:[Period];
    /// Swaptions flattened i_expiry major then j_tenor.
    effective_swap_starts:[string];
    effective_swap_ends:[string];
    strikes:[double];

    /// Flattening: swaptions Cube i_expiry major, j_tenor, k_strike; optionlets Cube i_expiry major, k_strike.
    vols:[double];
    n_expiries:int;
    n_tenors:int;
    n_strikes:int;

    /// Optional flattened ATM levels (par swap rates), i_expiry major then j_tenor. Populated when strike kind is SpreadFromATM.
    atm_levels:[double];

    error:Error;
}
