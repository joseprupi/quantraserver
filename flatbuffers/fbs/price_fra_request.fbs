include "common.fbs";
include "pricing.fbs";
include "fra.fbs";

namespace quantra;

/// Single FRA pricing request with curve references.
table PriceFRA {
    fra:FRA;
    /// Reference to curve in pricing.rates.curves by id.
    discounting_curve:string;
    /// Reference to curve in pricing.rates.curves for forward rates by id.
    forwarding_curve:string;
}

/// Request to price one or more FRAs.
table PriceFRARequest {
    pricing:Pricing;
    fras:[PriceFRA];
}

root_type PriceFRARequest;
