include "common.fbs";
include "pricing.fbs";
include "fra.fbs";

namespace quantra;

/// Single FRA pricing request with curve references.
table PriceFRA {
    fra:FRA;
    /// Reference to curve in pricing.rates.curves by id.
    discounting_curve:string;
    /// Reference to curve in pricing.rates.curves for forward rates by id.
    forwarding_curve:string;
}

/// Request to price one or more FRAs.
table PriceFRARequest {
    pricing:Pricing;
    fras:[PriceFRA];
    /// When true the response carries only the prices: `npvs` holds one NPV
    /// per trade in request order and the per-trade list is empty (no flows,
    /// fair values, greeks, echoes or diagnostics). The NPVs are the ones the
    /// full response reports; a request the engine refuses is refused the
    /// same way. Absent or false: the full response.
    price_only:bool = false;
}

root_type PriceFRARequest;
