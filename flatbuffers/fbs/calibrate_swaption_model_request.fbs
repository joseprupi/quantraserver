include "pricing.fbs";
include "model.fbs";

namespace quantra;

table CalibrateSwaptionModelRequest {
    // Full pricing context (as_of, curves, indices, vols, models, quotes).
    pricing:Pricing (required);
    // Model id inside pricing.models to calibrate.
    // Must refer to a SwaptionModelSpec with model_type=HullWhiteLattice.
    model_id:string (required);
    // Optional override for calibration settings.
    // If omitted, server uses model.hw_calibration from the referenced model.
    calibration:SwaptionHwCalibrationSpec;
}

root_type CalibrateSwaptionModelRequest;
