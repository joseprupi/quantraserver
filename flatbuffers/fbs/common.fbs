include "enums.fbs";

namespace quantra;

/// Canonical period type used across APIs.
table Period {
    n:int;
    unit:enums.TimeUnit = Months;
}

/// Yield/compounding convention specification.
table Yield {
    day_counter:enums.DayCounter;
    compounding:enums.Compounding;
    frequency:enums.Frequency;
}

/// Error message container.
table Error {
    error_message:string;
}

/// Interest cash flow with fixing and accrual metadata.
table FlowInterest {
    amount:double;
    fixing_date:string;
    accrual_start_date:string;
    accrual_end_date:string;
    discount:double;
    rate:double;
    price:double;
}

/// Past fixed interest cash flow.
table FlowPastInterest {
    amount:double;
    fixing_date:string;
    accrual_start_date:string;
    accrual_end_date:string;
    rate:double;
}

/// Notional exchange cash flow.
table FlowNotional {
    date:string;
    amount:double;
    discount:double;
    price:double;
}

/// Union of cash flow types.
union Flow { FlowInterest, FlowPastInterest, FlowNotional }

/// Wrapper for a single flow in a collection.
table FlowsWrapper {
    flow:Flow;
}
