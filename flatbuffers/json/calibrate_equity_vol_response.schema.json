    "quantra_SsviSlice" : {
      "type" : "object",
      "description" : "One eSSVI slice (Corbetta-Cohort-Laachir-Martini 2019 parametrisation): total variance\nw(k) = 0.5 (theta + rho psi k + sqrt(psi^2 k^2 + 2 rho psi theta k + theta^2)) in the\nlog-forward moneyness k = ln(K / F_ref(T)).",
      "properties" : {
        "expiry_date" : {
                "type" : "string",
                "description" : "Slice expiry (YYYY-MM-DD), strictly after base.reference_date."
              },
        "theta" : {
                "type" : "number",
                "description" : "ATM total implied variance, > 0. Presence-required for shape=SsviParams."
              },
        "rho" : {
                "type" : "number",
                "description" : "Correlation, in (-1, 1). Presence-required for shape=SsviParams."
              },
        "psi" : {
                "type" : "number",
                "description" : "psi = theta * phi, > 0. Presence-required for shape=SsviParams."
              },
        "forward" : {
                "type" : "number",
                "description" : "Forward F_ref(T) the slice is expressed against. Optional input for shape=SsviParams\n(all slices or none); always filled in /calibrate-equity-vol responses."
              }
      },
      "required" : ["expiry_date"],
      "additionalProperties" : false
    },
