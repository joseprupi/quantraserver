        "vol_id" : {
                "type" : "string",
                "description" : "References Pricing.vol_surfaces[].id."
              },
        "surface_type" : {
                "$ref" : "#/definitions/quantra_VolSurfaceType"
              },
        "expiry_grid" : {
                "$ref" : "#/definitions/quantra_DateGridSpec"
              },
        "tenor_grid" : {
                "$ref" : "#/definitions/quantra_DateGridSpec",
                "description" : "Required for swaption, ignored for optionlet."
              },
        "strike_grid" : {
                "$ref" : "#/definitions/quantra_StrikeGrid"
              },
        "options" : {
                "$ref" : "#/definitions/quantra_QueryOptions"
              },
        "output_mode" : {
                "$ref" : "#/definitions/quantra_VolOutputMode"
              },
        "swap_index_id" : {
                "type" : "string",
                "description" : "Optional override; must match surface swap_index_id if provided."
              },
        "slice_expiry_index" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Slice selectors (only used by slice modes). -1 means \"not set\"."
              },
        "slice_tenor_index" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "slice_strike" : {
                "type" : "number"
              },
        "slice_strike_is_set" : {
                "type" : "boolean",
                "description" : "Strict mode requires true for slice modes using slice_strike."
              },
        "discounting_curve_id" : {
                "type" : "string",
                "description" : "Required for SpreadFromATM swaption surfaces to compute ATM forwards."
              },
        "forwarding_curve_id" : {
                "type" : "string"
              }
      },
      "required" : ["vol_id", "expiry_grid", "strike_grid"],
      "additionalProperties" : false
    },
    "quantra_VolSurfaceSample" : {
      "type" : "object",
      "description" : "Sampled volatility surface output.",
      "properties" : {
        "vol_id" : {
                "type" : "string"
              },
        "reference_date" : {
                "type" : "string",
                "description" : "Vol surface reference date."
              },
        "ql_vol_type" : {
                "$ref" : "#/definitions/quantra_enums_VolatilityType"
              },
        "requested_strike_axis" : {
                "$ref" : "#/definitions/quantra_VolStrikeAxis"
              },
        "canonical_strike_kind" : {
                "$ref" : "#/definitions/quantra_enums_SwaptionStrikeKind"
              },
        "allow_extrapolation_used" : {
                "type" : "boolean"
              },
        "calendar_used" : {
                "$ref" : "#/definitions/quantra_enums_Calendar"
              },
        "business_day_convention_used" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              },
        "expiry_kind" : {
                "$ref" : "#/definitions/quantra_ExpiryKind",
                "description" : "Swaption: ExerciseDate and expiries are effective exercise dates. Optionlet: GridDate and expiries are grid dates."
              },
        "expiries" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Sampled expiry dates (ISO)."
              },
        "requested_expiry_grid_points" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Optional grid points after grid conventions."
              },
        "tenors" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Period"}
              },
        "effective_swap_starts" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Swaptions flattened i_expiry major then j_tenor."
              },
        "effective_swap_ends" : {
                "type" : "array", "items" : {"type" : "string"}
              },
        "strikes" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "vols" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Flattening: swaptions Cube i_expiry major, j_tenor, k_strike; optionlets Cube i_expiry major, k_strike."
              },
        "n_expiries" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "n_tenors" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "n_strikes" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "atm_levels" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Optional flattened ATM levels (par swap rates), i_expiry major then j_tenor. Populated when strike kind is SpreadFromATM."
              },
        "error" : {
                "$ref" : "#/definitions/quantra_Error"
              }
      },
      "required" : ["vol_id"],
      "additionalProperties" : false
    },
    "quantra_SabrCalibrationDiagnostics" : {
      "type" : "object",
      "description" : "Calibration-specific diagnostics. Populated only for SABR surfaces whose\nkind is SabrCalibrate. For SabrParams surfaces (and other kinds in future\nextensions) this sub-block is absent on the parent SwaptionVolDiagnostics.",
      "properties" : {
        "per_node_rmse" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Root-mean-square fit error per (expiry, tenor) node, row-major nExp*nTen."
              },
        "per_node_max_abs_error" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Worst single-strike absolute error per (expiry, tenor) node, row-major nExp*nTen."
              },
        "overall_rmse" : {
                "type" : "number",
                "description" : "Aggregate RMSE across the entire cube."
              },
        "converged" : {
                "type" : "boolean",
                "description" : "True iff every node converged to a stationary point (i.e., end criteria\nis not None and not MaxIterations on any node)."
              },
        "iterations_per_node" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647},
                "description" : "Iteration count per node. Sentinel -1 indicates \"not exposed by the\noptimizer\" — current QuantLib (1.41) does not expose this publicly from\nthe SABR interpolator, so v1 always emits -1. Field is retained for\nschema forward-compatibility."
              },
        "strikes" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Strike spreads used in calibration (rate units, e.g. -0.02 = -200bp).\nSame vector applied at every (expiry, tenor) node."
              },
        "per_strike_fit_error" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-strike fit error (fitted - market) for each (expiry, tenor, strike).\nRow-major nExp*nTen*nStrikes."
              }
      },
      "additionalProperties" : false
    },
    "quantra_SwaptionVolDiagnostics" : {
      "type" : "object",
      "description" : "Diagnostics block describing one swaption vol surface. Emitted opt-in by\n/sample-vol-surfaces and /price-swaption when include_diagnostics=true, and\nreused as the response body for the standalone /calibrate-swaption-vol\nendpoint.",
      "properties" : {
        "vol_id" : {
                "type" : "string",
                "description" : "Matches Pricing.volatility.vol_surfaces[].id."
              },
        "kind" : {
                "$ref" : "#/definitions/quantra_enums_SwaptionVolKind",
                "description" : "Resolved swaption vol kind for the surface."
              },
        "expiries" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Period"},
                "description" : "Per-node grid axes, mirroring the surface's pillars."
              },
        "tenors" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Period"}
              },
        "n_expiries" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "n_tenors" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "forward_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-node forwards F(expiry, tenor), populated when handle is built.\nRow-major nExp*nTen."
              },
        "atm_vol_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-node ATM vols sigma(F) evaluated via Hagan. Row-major nExp*nTen."
              },
        "time_to_expiry_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Time-to-expiry in years for each node. Row-major nExp*nTen."
              },
        "alpha_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
