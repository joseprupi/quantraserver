        "swap_type" : {
                "$ref" : "#/definitions/quantra_enums_SwapType",
                "description" : "\"Payer\" / \"Receiver\" refers to the inflation leg."
              },
        "notional" : {
                "type" : "number"
              },
        "start_date" : {
                "type" : "string"
              },
