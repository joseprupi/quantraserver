    "quantra_SabrCalibrationDiagnostics" : {
      "type" : "object",
      "description" : "Calibration-specific diagnostics. Populated only for SABR surfaces whose\nkind is SabrCalibrate. For SabrParams surfaces (and other kinds in future\nextensions) this sub-block is absent on the parent SwaptionVolDiagnostics.",
      "properties" : {
        "per_node_rmse" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Root-mean-square fit error per (expiry, tenor) node, row-major nExp*nTen."
              },
        "per_node_max_abs_error" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Worst single-strike absolute error per (expiry, tenor) node, row-major nExp*nTen."
              },
        "overall_rmse" : {
                "type" : "number",
                "description" : "Aggregate RMSE across the entire cube."
              },
        "converged" : {
                "type" : "boolean",
                "description" : "True iff every node converged to a stationary point (i.e., end criteria\nis not None and not MaxIterations on any node)."
              },
        "iterations_per_node" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647},
                "description" : "Iteration count per node. Sentinel -1 indicates \"not exposed by the\noptimizer\" — current QuantLib (1.41) does not expose this publicly from\nthe SABR interpolator, so v1 always emits -1. Field is retained for\nschema forward-compatibility."
              },
        "strikes" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Strike spreads used in calibration (rate units, e.g. -0.02 = -200bp).\nSame vector applied at every (expiry, tenor) node."
              },
        "per_strike_fit_error" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-strike fit error (fitted - market) for each (expiry, tenor, strike).\nRow-major nExp*nTen*nStrikes."
              }
      },
      "additionalProperties" : false
    },
    "quantra_SwaptionVolDiagnostics" : {
      "type" : "object",
      "description" : "Diagnostics block describing one swaption vol surface. Emitted opt-in by\n/sample-vol-surfaces and /price-swaption when include_diagnostics=true, and\nreused as the response body for the standalone /calibrate-swaption-vol\nendpoint.",
      "properties" : {
        "vol_id" : {
                "type" : "string",
                "description" : "Matches Pricing.volatility.vol_surfaces[].id."
              },
        "kind" : {
                "$ref" : "#/definitions/quantra_enums_SwaptionVolKind",
                "description" : "Resolved swaption vol kind for the surface."
              },
        "expiries" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Period"},
                "description" : "Per-node grid axes, mirroring the surface's pillars."
              },
        "tenors" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Period"}
              },
        "n_expiries" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "n_tenors" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "forward_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-node forwards F(expiry, tenor), populated when handle is built.\nRow-major nExp*nTen."
              },
        "atm_vol_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-node ATM vols sigma(F) evaluated via Hagan. Row-major nExp*nTen."
              },
        "time_to_expiry_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Time-to-expiry in years for each node. Row-major nExp*nTen."
              },
        "alpha_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "SABR parameters in effect at each node. For SabrParams these are the\nuser-supplied values; for SabrCalibrate these are calibrator output.\nRow-major nExp*nTen, schema field order alpha, beta, rho, nu."
              },
        "beta_per_node" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "rho_per_node" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "nu_per_node" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "calibration" : {
                "$ref" : "#/definitions/quantra_SabrCalibrationDiagnostics",
                "description" : "Calibration sub-block. Present only for SabrCalibrate; absent for\nSabrParams (and other kinds in future extensions)."
              },
        "warnings" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Validation warnings. Empty when fit is healthy."
              }
      },
      "required" : ["vol_id"],
      "additionalProperties" : false
    },
    "quantra_EquityVolSliceDiagnostics" : {
      "type" : "object",
      "description" : "One calibrated eSSVI slice of /calibrate-equity-vol. Vols and errors are decimals\n(0.01 = one vol point).",
      "properties" : {
        "expiry_date" : {
                "type" : "string"
              },
        "time" : {
                "type" : "number",
                "description" : "Year fraction from the reference date (surface day counter)."
              },
        "pcp_forward" : {
                "type" : "number",
                "description" : "Forward used for the fit: put-call parity when calls and puts exist at >= 2 common\nstrikes, else the curve forward (an expiry without parity pairs needs a dividend curve)."
              },
        "curve_forward" : {
                "type" : "number",
                "description" : "Forward from the spot, dividend and discount curves. Null when the surface has no\ndividend curve."
              },
        "implied_dividend_yield" : {
                "type" : "number",
                "description" : "-ln(pcp_forward Dr(T) / S0) / T."
              },
        "anchor_k" : {
                "type" : "number",
                "description" : "Anchor quote (closest to the money) log-moneyness and total variance, after clamping."
              },
        "anchor_theta" : {
                "type" : "number"
              },
        "anchor_clamped" : {
                "type" : "boolean",
                "description" : "True when the anchor total variance was raised to keep the calendar condition feasible."
              },
        "used_quotes" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "excluded_quotes" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "rmse" : {
                "type" : "number",
                "description" : "Root-mean-square and max absolute error of the used quotes, decimal vol."
              },
        "max_abs_error" : {
                "type" : "number"
              },
        "margin_butterfly_psi" : {
                "type" : "number",
                "description" : "Constraint margins, rhs - lhs, >= 0 when satisfied (see ssvi_calibrator.h)."
              },
        "margin_butterfly_psi2" : {
                "type" : "number"
              },
        "margin_calendar_theta" : {
                "type" : "number",
                "description" : "Calendar margins versus the previous slice; absent on the first slice."
              },
        "margin_calendar_psi" : {
                "type" : "number"
              },
        "margin_calendar_a" : {
                "type" : "number"
              },
        "parity_pairs_used" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Put-call pairs (common strikes) behind pcp_forward, after outlier rejection; 0 when the\nforward is the curve forward."
              },
        "parity_pairs_rejected" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Pairs dropped as outliers: further than max(5 * 1.4826 MAD, 1e-4 pcp_forward) from the\nmedian pair forward (only with >= 3 pairs). Both quotes are excluded as \"parity_outlier\"."
              }
      },
      "required" : ["expiry_date"],
      "additionalProperties" : false
    },
    "quantra_EquityVolQuoteDiagnostics" : {
      "type" : "object",
      "description" : "One input quote of /calibrate-equity-vol with its fit residual.",
      "properties" : {
        "expiry_date" : {
                "type" : "string"
              },
        "strike" : {
                "type" : "number"
              },
        "option_type" : {
                "$ref" : "#/definitions/quantra_enums_EquityOptionType"
              },
        "market_vol" : {
                "type" : "number",
                "description" : "Implied vol of the quote (decimal); absent when it could not be solved (unused quotes)."
              },
        "model_vol" : {
                "type" : "number"
              },
        "residual" : {
                "type" : "number",
                "description" : "model_vol - market_vol, decimal vol; absent with market_vol."
              },
        "weight" : {
                "type" : "number",
                "description" : "The user weight of the quote."
              },
        "used" : {
                "type" : "boolean"
              },
        "exclusion_reason" : {
                "type" : "string",
                "description" : "Empty for used quotes. Otherwise the first that applies:\nprice_outside_bounds      price outside (intrinsic, D F) for a call or (intrinsic, D K)\nfor a put at the slice forward F;\nparity_outlier            one of a put-call pair rejected from the parity forward;\nimplied_vol_not_solved    the implied-vol solve failed;\nin_the_money_side         the out-of-the-money quote of the same strike is used instead;\nmax_abs_log_moneyness     |ln(K / F)| beyond SsviFitSpec.max_abs_log_moneyness;\nimplied_vol_not_positive  implied total variance is not > 0;\nask_not_above_bid         BidAsk weighting and ask <= bid.\nA slice needs at least 3 used quotes, otherwise the request is rejected."
              }
      },
      "required" : ["expiry_date"],
      "additionalProperties" : false
    },
    "quantra_EquityVolDiagnostics" : {
      "type" : "object",
      "description" : "Diagnostics block of /calibrate-equity-vol.",
      "properties" : {
        "slices" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_EquityVolSliceDiagnostics"}
              },
        "quotes" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_EquityVolQuoteDiagnostics"}
              },
        "excluded_by_moneyness" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Quotes dropped for |k| > max_abs_log_moneyness."
              },
        "overall_rmse" : {
                "type" : "number"
              },
        "overall_max_abs_error" : {
                "type" : "number"
              },
        "violations" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Arbitrage violations found after the fit (empty on success)."
              },
        "scan_min_g" : {
                "type" : "number",
                "description" : "Minimum of the Durrleman function g(k, k) and of dw/dt over the scan grid, with the\n(t, k) where they occur."
              },
        "scan_min_g_t" : {
                "type" : "number"
              },
        "scan_min_g_k" : {
                "type" : "number"
              },
        "scan_min_w_t" : {
                "type" : "number"
              },
        "scan_min_w_t_t" : {
                "type" : "number"
              },
        "scan_min_w_t_k" : {
                "type" : "number"
              }
      },
      "additionalProperties" : false
    },
    "quantra_CalibrateSwaptionVolResponse" : {
      "type" : "object",
      "description" : "Response from /calibrate-swaption-vol: a single SwaptionVolDiagnostics\nblock describing the calibrated surface. Wrapped in a thin envelope rather\nthan using SwaptionVolDiagnostics as `root_type` directly so that future\nadditions (status field, audit metadata, etc.) don't break the schema —\nsame pattern as CalibrateSwaptionModelResponse.",
      "properties" : {
