    },
    "quantra_IndexDef" : {
      "type" : "object",
      "description" : "Complete index definition. Registered once per request, referenced by id.",
      "properties" : {
        "id" : {
                "type" : "string",
                "description" : "Unique identifier (e.g., \"EUR_6M\", \"USD_SOFR\", \"MY_CUSTOM_3M\")."
              },
        "name" : {
                "type" : "string",
                "description" : "Human-readable name / family label (e.g., \"Euribor\", \"SOFR\")."
              },
        "index_type" : {
                "$ref" : "#/definitions/quantra_IndexType",
                "description" : "IBOR or Overnight. Determines QuantLib class used. Presence-required: an\nomitted value is a 400, never the silent Ibor default."
              },
        "tenor" : {
                "$ref" : "#/definitions/quantra_Period",
                "description" : "Tenor period (e.g., 6 Months for Euribor 6M, 0 Days for overnight)."
              },
        "fixing_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Fixing days (e.g., 2 for Euribor, 0 for SOFR/ESTR). Presence-required."
              },
        "calendar" : {
                "$ref" : "#/definitions/quantra_enums_Calendar",
                "description" : "Calendar for fixing/payment dates. Presence-required."
              },
        "business_day_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention",
                "description" : "Business day convention. Presence-required."
              },
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter",
                "description" : "Day count convention. Presence-required."
              },
        "end_of_month" : {
                "type" : "boolean",
                "description" : "End of month rule (IBOR only, ignored for overnight). Presence-required:\nabsent-vs-false silently changes money-market schedule dates."
              },
        "currency" : {
                "type" : "string",
                "description" : "ISO currency code (e.g., \"EUR\", \"USD\", \"GBP\", \"JPY\")."
              },
        "fixings" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Fixing"},
                "description" : "Past fixings needed for seasoned instruments."
              }
      },
      "required" : ["id", "name"],
      "additionalProperties" : false
    },
    "quantra_IndexRef" : {
      "type" : "object",
      "description" : "Reference to an IndexDef by its id.",
      "properties" : {
        "id" : {
                "type" : "string"
              }
      },
      "required" : ["id"],
      "additionalProperties" : false
    },
    "quantra_PriceSeries" : {
      "type" : "object",
      "description" : "One underlying's price history: closes on strictly increasing dates,\nevery value > 0. The engine never fetches prices; it receives them.",
      "properties" : {
        "underlying_id" : {
                "type" : "string",
                "description" : "`EquityUnderlyingSpec.id` the series stands for; becomes a label of\nthe returned correlation matrix. Required, unique within `series`."
              },
        "closes" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Fixing"},
                "description" : "`{date, value}` closes in strictly increasing date order (400\notherwise), value > 0. Required, at least one entry."
              }
      },
      "required" : ["underlying_id", "closes"],
      "additionalProperties" : false
    },
    "quantra_CorrelationEstimator" : {
      "type" : "object",
      "description" : "Settings of the historical correlation estimator. Every field has a\ndefault; the response echoes the settings as resolved (an explicit\nwindow instead of `window_days`) so the result can be reproduced from\nthe echo alone.",
      "properties" : {
        "window_days" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Calendar days back from `as_of_date`: the window is\n[as_of_date - window_days, as_of_date]. Absent and no explicit\nwindow: every date common to all series is used, closes after\n`as_of_date` included. Must be > 0; 400 together with `start_date`\nor `end_date`."
              },
        "start_date" : {
                "type" : "string",
                "description" : "Explicit window, inclusive, ISO dates; either bound may be absent\n(no bound on that side). 400 with `window_days`, or when\n`start_date` is after `end_date`."
              },
        "end_date" : {
                "type" : "string"
              },
        "returns" : {
                "$ref" : "#/definitions/quantra_enums_ReturnType",
                "description" : "Returns: Log (default) or Simple."
              },
        "frequency" : {
                "$ref" : "#/definitions/quantra_enums_ReturnFrequency",
                "description" : "Daily (default, every common date) or Weekly (every fifth common\nobservation counted back from the last)."
              },
        "shrinkage" : {
                "$ref" : "#/definitions/quantra_enums_CorrelationShrinkage",
                "description" : "None, LedoitWolf (default) or Fixed."
              },
        "shrinkage_intensity" : {
                "type" : "number",
                "description" : "Intensity in [0, 1] toward the constant-correlation target. Required\niff `shrinkage` is Fixed (400 otherwise)."
              },
        "min_overlap" : {
                "type" : "integer", "minimum" : 0, "maximum" : 4294967295,
                "description" : "Least number of dates common to all series inside the window (before\nthe frequency sampling); 400 below it. Must be >= 3."
              },
        "eigenvalue_floor" : {
                "type" : "number",
                "description" : "Eigenvalue the negative ones are raised to when the estimated (and\nshrunk) matrix is not positive semi-definite to the registry's\ntolerance (smallest eigenvalue below -1e-10; a rank-deficient matrix\nsuch as a perfectly correlated pair, eigenvalue 0, is returned as\nis): eigenvalues clipped to the floor, the matrix rescaled to unit\ndiagonal, the response says so. Finite, in [0, 1)."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CalibrateCorrelationRequest" : {
      "type" : "object",
      "description" : "Request for `/calibrate-correlation`: a correlation matrix, ready to\npaste under `pricing.correlations.matrices`, from the price histories\nof two or more underlyings. Returns on the dates common to every series\ninside the window, sample correlation, optional shrinkage toward the\nconstant-correlation target, positive semi-definiteness enforced by an\neigenvalue floor. There is no `pricing` block: the endpoint reads no\nmarket data other than the closes given here.",
      "properties" : {
        "as_of_date" : {
                "type" : "string",
                "description" : "Anchor of `window_days` and the date the estimate is labelled with.\nRequired. Closes after it are not an error (they are used unless a\nwindow excludes them)."
              },
        "series" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_PriceSeries"},
                "description" : "At least two series with distinct `underlying_id`s. Required."
              },
        "estimator" : {
                "$ref" : "#/definitions/quantra_CorrelationEstimator",
                "description" : "Estimator settings; the defaults apply when absent."
              },
        "correlation_id" : {
                "type" : "string",
                "description" : "Id given to the returned `CorrelationMatrixSpec`. Required."
              },
        "labels" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Row/column order of the returned matrix: a permutation of the\n`underlying_id`s of `series` (400 otherwise). Absent = series order."
              }
      },
      "required" : ["as_of_date", "series", "correlation_id"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_CalibrateCorrelationRequest"
}
