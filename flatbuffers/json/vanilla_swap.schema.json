    },
    "quantra_enums_FRAType" : {
      "type" : "string",
      "enum": ["Long", "Short"]
    },
    "quantra_enums_CapFloorType" : {
      "type" : "string",
      "enum": ["Cap", "Floor", "Collar"]
    },
    "quantra_enums_CallabilityType" : {
      "type" : "string",
      "enum": ["Call", "Put"]
    },
    "quantra_enums_ExerciseType" : {
      "type" : "string",
      "enum": ["European", "Bermudan", "American"]
    },
    "quantra_enums_SettlementType" : {
      "type" : "string",
      "enum": ["Physical", "Cash"]
    },
    "quantra_enums_SettlementMethod" : {
      "type" : "string",
      "enum": ["PhysicalOTC", "PhysicalCleared", "CollateralizedCashPrice", "ParYieldCurve"]
    },
    "quantra_enums_ProtectionSide" : {
      "type" : "string",
      "enum": ["Buyer", "Seller"]
    },
    "quantra_enums_VolatilityType" : {
      "type" : "string",
      "enum": ["Normal", "Lognormal", "ShiftedLognormal"]
    },
    "quantra_enums_VolSurfaceShape" : {
      "type" : "string",
      "enum": ["Constant", "AtmMatrix2D", "SmileCube3D", "SurfaceFromPrices", "SabrParams", "SabrCalibrate"]
    },
    "quantra_enums_YoYInflationCapFloorEngineType" : {
      "type" : "string",
      "enum": ["Black", "UnitDisplacedBlack", "Bachelier"]
    },
    "quantra_enums_SwaptionVolKind" : {
      "type" : "string",
      "enum": ["Constant", "AtmMatrix2D", "SmileCube3D", "SabrParams", "SabrCalibrate"]
    },
    "quantra_enums_SwaptionStrikeKind" : {
      "type" : "string",
