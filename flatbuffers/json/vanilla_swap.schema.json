      "enum": ["ZeroInflation", "YoYInflation"]
    },
    "quantra_enums_InflationCurveMeasure" : {
      "type" : "string",
      "enum": ["ZeroRate", "YoYRate"]
    },
    "quantra_enums_CPIInterpolationType" : {
      "type" : "string",
      "enum": ["AsIndex", "Flat", "Linear"]
    },
    "quantra_enums_BondPriceType" : {
      "type" : "string",
      "enum": ["Clean", "Dirty"]
    },
    "quantra_enums_IrModelType" : {
      "type" : "string",
      "enum": ["Black", "ShiftedBlack", "Bachelier", "HullWhiteLattice"]
    },
    "quantra_enums_ModelParamMode" : {
      "type" : "string",
      "enum": ["Explicit", "Calibrate"]
    },
    "quantra_enums_CmsPricerType" : {
      "type" : "string",
      "enum": ["LinearTsr", "HaganAnalytic", "HaganNumeric"]
    },
    "quantra_enums_CmsYieldCurveModel" : {
      "type" : "string",
      "enum": ["Standard", "ExactYield", "ParallelShifts", "NonParallelShifts"]
    },
    "quantra_enums_EquityModelType" : {
      "type" : "string",
      "enum": ["BlackScholesAnalytic", "BinomialCRR"]
    },
    "quantra_enums_EquityOptionType" : {
      "type" : "string",
      "enum": ["Call", "Put"]
    },
    "quantra_enums_EquitySettlementType" : {
      "type" : "string",
      "enum": ["Physical", "Cash"]
    },
    "quantra_enums_EquityBarrierType" : {
      "type" : "string",
      "enum": ["DownIn", "UpIn", "DownOut", "UpOut"]
    },
    "quantra_enums_EquityBarrierMonitoring" : {
      "type" : "string",
      "enum": ["Continuous", "Discrete"]
    },
    "quantra_Flow" : {
      "type" : "string",
      "enum": ["NONE", "FlowInterest", "FlowPastInterest", "FlowNotional"]
    },
    "quantra_IndexType" : {
      "type" : "string",
      "enum": ["Ibor", "Overnight"]
    },
    "quantra_Schedule" : {
      "type" : "object",
      "description" : "Date schedule definition for payment and accrual dates.",
      "properties" : {
        "calendar" : {
                "$ref" : "#/definitions/quantra_enums_Calendar"
              },
        "effective_date" : {
                "type" : "string"
              },
        "termination_date" : {
                "type" : "string"
              },
        "frequency" : {
                "$ref" : "#/definitions/quantra_enums_Frequency"
              },
        "convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              },
        "termination_date_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              },
        "date_generation_rule" : {
                "$ref" : "#/definitions/quantra_enums_DateGenerationRule"
              },
        "end_of_month" : {
                "type" : "boolean"
              },
        "first_date" : {
                "type" : "string",
                "description" : "Optional. ISO-8601 (YYYY-MM-DD). When present, passed as QuantLib's\nfirstDate, which controls the FIRST stub coupon: with Backward date\ngeneration a first_date after effective_date creates a short/long first\nperiod; with Forward generation it anchors the regular periods. Must lie\nstrictly between effective_date and termination_date. Omit for no first\nstub (bit-identical to prior behaviour)."
              },
        "next_to_last_date" : {
                "type" : "string",
                "description" : "Optional. ISO-8601 (YYYY-MM-DD). When present, passed as QuantLib's\nnextToLastDate, controlling the LAST stub coupon symmetrically to\nfirst_date. Must lie strictly between effective_date and\ntermination_date (and, when first_date is also present, on or after it).\nOmit for no last stub (bit-identical to prior behaviour)."
              }
      },
      "additionalProperties" : false
    },
    "quantra_Period" : {
      "type" : "object",
      "description" : "Canonical period type used across APIs.",
      "properties" : {
        "n" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "unit" : {
                "$ref" : "#/definitions/quantra_enums_TimeUnit"
              }
      },
      "additionalProperties" : false
    },
    "quantra_Yield" : {
      "type" : "object",
      "description" : "Yield/compounding convention specification.",
      "properties" : {
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter"
              },
        "compounding" : {
                "$ref" : "#/definitions/quantra_enums_Compounding"
              },
        "frequency" : {
                "$ref" : "#/definitions/quantra_enums_Frequency"
              }
      },
      "additionalProperties" : false
    },
    "quantra_Error" : {
      "type" : "object",
      "description" : "Error message container.",
      "properties" : {
        "error_message" : {
                "type" : "string"
              }
      },
      "additionalProperties" : false
    },
    "quantra_FlowInterest" : {
      "type" : "object",
      "description" : "Interest cash flow with fixing and accrual metadata.",
      "properties" : {
        "amount" : {
                "type" : "number"
              },
        "fixing_date" : {
                "type" : "string"
              },
        "accrual_start_date" : {
                "type" : "string"
              },
        "accrual_end_date" : {
                "type" : "string"
              },
        "discount" : {
                "type" : "number"
              },
        "rate" : {
                "type" : "number"
              },
        "price" : {
                "type" : "number"
              }
      },
      "additionalProperties" : false
    },
    "quantra_FlowPastInterest" : {
      "type" : "object",
      "description" : "Past fixed interest cash flow.",
      "properties" : {
        "amount" : {
                "type" : "number"
              },
        "fixing_date" : {
                "type" : "string"
              },
        "accrual_start_date" : {
                "type" : "string"
              },
        "accrual_end_date" : {
                "type" : "string"
              },
        "rate" : {
                "type" : "number"
              }
      },
      "additionalProperties" : false
    },
    "quantra_FlowNotional" : {
      "type" : "object",
      "description" : "Notional exchange cash flow.",
      "properties" : {
        "date" : {
                "type" : "string"
              },
        "amount" : {
                "type" : "number"
              },
        "discount" : {
                "type" : "number"
              },
        "price" : {
                "type" : "number"
              }
      },
      "additionalProperties" : false
    },
    "quantra_FlowsWrapper" : {
      "type" : "object",
      "description" : "Wrapper for a single flow in a collection.",
      "properties" : {
        "flow_type" : {
                "$ref" : "#/definitions/quantra_Flow"
              },
        "flow" : {
                "anyOf": [{ "$ref" : "#/definitions/quantra_FlowInterest" },{ "$ref" : "#/definitions/quantra_FlowPastInterest" },{ "$ref" : "#/definitions/quantra_FlowNotional" }]
              }
      },
      "additionalProperties" : false
    },
    "quantra_Fixing" : {
      "type" : "object",
      "description" : "Historical index fixing for seasoned instruments.",
      "properties" : {
        "date" : {
                "type" : "string"
              },
        "value" : {
                "type" : "number"
              }
      },
      "required" : ["date"],
      "additionalProperties" : false
    },
    "quantra_IndexDef" : {
      "type" : "object",
      "description" : "Complete index definition. Registered once per request, referenced by id.",
      "properties" : {
        "id" : {
                "type" : "string",
                "description" : "Unique identifier (e.g., \"EUR_6M\", \"USD_SOFR\", \"MY_CUSTOM_3M\")."
              },
        "name" : {
                "type" : "string",
                "description" : "Human-readable name / family label (e.g., \"Euribor\", \"SOFR\")."
              },
        "index_type" : {
                "$ref" : "#/definitions/quantra_IndexType",
                "description" : "IBOR or Overnight. Determines QuantLib class used."
              },
        "tenor" : {
                "$ref" : "#/definitions/quantra_Period",
                "description" : "Tenor period (e.g., 6 Months for Euribor 6M, 0 Days for overnight)."
              },
        "fixing_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Fixing days (e.g., 2 for Euribor, 0 for SOFR/ESTR)."
              },
        "calendar" : {
                "$ref" : "#/definitions/quantra_enums_Calendar",
                "description" : "Calendar for fixing/payment dates."
              },
        "business_day_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention",
                "description" : "Business day convention."
              },
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter",
                "description" : "Day count convention."
              },
        "end_of_month" : {
                "type" : "boolean",
                "description" : "End of month rule (IBOR only, ignored for overnight)."
              },
        "currency" : {
                "type" : "string",
                "description" : "ISO currency code (e.g., \"EUR\", \"USD\", \"GBP\", \"JPY\")."
              },
        "fixings" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Fixing"},
                "description" : "Past fixings needed for seasoned instruments."
              }
      },
      "required" : ["id", "name"],
      "additionalProperties" : false
    },
    "quantra_IndexRef" : {
      "type" : "object",
      "description" : "Reference to an IndexDef by its id.",
      "properties" : {
        "id" : {
                "type" : "string"
              }
      },
      "required" : ["id"],
      "additionalProperties" : false
    },
    "quantra_SwapFixedLeg" : {
      "type" : "object",
      "description" : "Fixed leg of a swap.",
      "properties" : {
        "schedule" : {
                "$ref" : "#/definitions/quantra_Schedule"
              },
        "notional" : {
                "type" : "number"
              },
        "notionals" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Optional per-period notionals, one entry per coupon period in schedule\norder. Present => amortizing/step-up leg (overrides `notional`); absent\n=> constant `notional`. Honored only on the vanilla fixed-vs-IBOR swap\npath; other readers (OIS, swaption underlying) reject a present value."
              },
        "rate" : {
                "type" : "number"
              },
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter"
              },
        "payment_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              }
      },
      "additionalProperties" : false
    },
    "quantra_SwapFloatingLeg" : {
      "type" : "object",
      "description" : "Floating leg of a swap.",
      "properties" : {
        "schedule" : {
                "$ref" : "#/definitions/quantra_Schedule"
              },
        "notional" : {
                "type" : "number"
              },
        "notionals" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Optional per-period notionals, one entry per coupon period in schedule\norder. Present => amortizing/step-up leg (overrides `notional`); absent\n=> constant `notional`. Honored only on the vanilla fixed-vs-IBOR swap\npath; other readers (basis swap, swaption underlying) reject a present\nvalue."
              },
        "index" : {
                "$ref" : "#/definitions/quantra_IndexRef",
                "description" : "Reference to an IndexDef by id (e.g., \"EUR_6M\")."
              },
        "spread" : {
                "type" : "number"
              },
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter"
              },
        "payment_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              },
        "fixing_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "in_arrears" : {
                "type" : "boolean"
              }
      },
      "required" : ["index"],
      "additionalProperties" : false
    },
    "quantra_CmsPricerSpec" : {
      "type" : "object",
      "description" : "CMS leg of a swap.\nCoupon formula: notional * accrual * (gear * CMSRate + spread).",
      "properties" : {
        "pricer_type" : {
                "$ref" : "#/definitions/quantra_enums_CmsPricerType",
                "description" : "CMS coupon pricer implementation."
              },
        "yield_curve_model" : {
                "$ref" : "#/definitions/quantra_enums_CmsYieldCurveModel",
                "description" : "Yield-curve model used by Hagan-family pricers."
              },
        "mean_reversion" : {
                "type" : "number",
                "description" : "Mean reversion parameter used by TSR/Hagan-family pricers."
              },
        "hagan_lower_limit" : {
                "type" : "number",
                "description" : "Numeric Hagan lower integration limit."
              },
        "hagan_upper_limit" : {
                "type" : "number",
                "description" : "Numeric Hagan upper integration limit."
              },
        "hagan_precision" : {
                "type" : "number",
                "description" : "Numeric Hagan integration precision."
              },
        "hagan_hard_upper_limit" : {
                "type" : "number",
                "description" : "Numeric Hagan hard upper integration limit.\nIf <= 0.0, QuantLib default hard upper limit is used."
              }
      },
      "additionalProperties" : false
    },
    "quantra_SwapCmsLeg" : {
      "type" : "object",
      "description" : "CMS leg of a swap.\nCoupon formula: notional * accrual * (gear * CMSRate + spread).",
      "properties" : {
        "schedule" : {
                "$ref" : "#/definitions/quantra_Schedule",
                "description" : "Coupon/payment schedule."
              },
        "notional" : {
                "type" : "number",
                "description" : "Coupon notional."
              },
        "swap_index_id" : {
                "type" : "string",
                "description" : "Swap index conventions id from Pricing.swap_indices (e.g. \"EUR_SWAP_6M\")."
              },
        "swap_tenor" : {
                "$ref" : "#/definitions/quantra_Period",
                "description" : "Constant maturity tenor for CMS fixing (e.g. 10Y)."
              },
        "swaption_vol_id" : {
                "type" : "string",
                "description" : "Swaption volatility surface id from Pricing.vol_surfaces used by CMS pricer."
              },
        "fixing_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Optional fixing days override; if negative, uses swap index spot_days."
              },
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter",
                "description" : "Coupon accrual day-count convention."
              },
        "payment_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention",
                "description" : "Payment business-day convention."
              },
        "gear" : {
                "type" : "number",
                "description" : "Coupon gearing multiplier."
              },
        "spread" : {
                "type" : "number",
                "description" : "Coupon additive spread."
              },
        "pricer" : {
                "$ref" : "#/definitions/quantra_CmsPricerSpec",
                "description" : "Optional CMS coupon pricer configuration.\nIf null, defaults are used (LinearTsr with mean_reversion=0.03)."
              },
        "cap" : {
                "type" : "number",
                "description" : "Optional cap strike. Present => every CMS coupon is capped at this rate\n(produces CappedFlooredCmsCoupons). Absent => uncapped."
              },
        "floor" : {
                "type" : "number",
                "description" : "Optional floor strike. Present => every CMS coupon is floored at this rate.\nAbsent => unfloored. If both cap and floor are present, cap must be >= floor."
              }
      },
      "required" : ["swap_index_id", "swap_tenor", "swaption_vol_id"],
      "additionalProperties" : false
    },
    "quantra_VanillaSwap" : {
      "type" : "object",
      "description" : "Vanilla interest rate swap (fixed vs floating).",
      "properties" : {
        "swap_type" : {
                "$ref" : "#/definitions/quantra_enums_SwapType",
                "description" : "Payer/receiver refer to the fixed leg. Presence-required: an omitted\ntype is a 400, never the alphabetical-0 default (Payer)."
              },
        "fixed_leg" : {
                "$ref" : "#/definitions/quantra_SwapFixedLeg"
              },
        "floating_leg" : {
                "$ref" : "#/definitions/quantra_SwapFloatingLeg",
                "description" : "Standard IBOR floating leg path."
              },
        "cms_leg" : {
                "$ref" : "#/definitions/quantra_SwapCmsLeg",
                "description" : "Optional CMS floating leg path.\nExactly one of floating_leg or cms_leg must be provided."
              }
      },
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_VanillaSwap"
}
