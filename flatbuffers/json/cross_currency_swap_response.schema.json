    "quantra_CrossCurrencySwapResponse" : {
      "type" : "object",
      "description" : "Cross-currency swap pricing result. With, for leg i, L_i the leg's flows\nin its own frame (coupons +, initial exchange -N_i at the schedule start,\nfinal exchange +N_i with the last coupon), D_i its discounting curve,\ns_1 = -1 for `Payer` / +1 for `Receiver` and s_2 = -s_1, S the spot rate\n(delivery on the spot date t_s) and DF_base / DF_quote the discounting\ncurves of the base- and quote-currency legs:\nleg_i_npv = s_i * CashFlows::npv(L_i, D_i)                [currency i]\nX         = S * DF_quote(t_s) / DF_base(t_s)              [quote per base, as of today]\nleg_i_npv_reporting = leg_i_npv, * X or / X               [reporting currency]\nnpv       = leg1_npv_reporting + leg2_npv_reporting       [reporting currency]\nFair quantities hold the other leg and every exchange fixed and solve the\nlinear equation in the fixed rate / the spread with the leg's annuity\nA_i = CashFlows::bps(coupons of leg i, D_i) / 1e-4 (exchanges excluded):\nfair_rate   = rate_f   - NPV[in fixed-leg ccy]  / (s_f * A_f)\nfair_spread = spread_2 - NPV[in leg-2 ccy]      / (s_2 * A_2)\nso repricing at the fair value gives npv = 0 to rounding. Every value is\nas of the evaluation date (the curves' reference date).",
      "properties" : {
        "npv" : {
                "type" : "number",
                "description" : "Total present value in `reporting_currency`, positive in favour of the\nparty whose `swap_type` was given."
              },
        "leg1_npv" : {
                "type" : "number",
                "description" : "Present value of leg1 (coupons and exchanges) in `leg1.currency`,\nsigned from the reported party's view: the leg's own-frame value (as\nits receiver sees it) times -1 when the party pays the leg (`Payer`)\nand +1 when it receives it. A paid leg is therefore negative only\nwhen it is worth paying for: paying a 2.55% fixed leg (with its\nexchanges) on a 3% curve is in the payer's favour and positive."
              },
        "leg2_npv" : {
                "type" : "number",
                "description" : "Present value of leg2 (coupons and exchanges) in `leg2.currency`,\nsigned the same way (+1 for `Payer`, -1 for `Receiver`)."
              },
        "leg1_npv_reporting" : {
                "type" : "number",
                "description" : "`leg1_npv` converted to `reporting_currency` at the as-of exchange\nrate (unchanged when leg1 is in the reporting currency)."
              },
        "leg2_npv_reporting" : {
                "type" : "number",
                "description" : "`leg2_npv` converted to `reporting_currency` at the as-of exchange\nrate (unchanged when leg2 is in the reporting currency)."
              },
        "fair_rate" : {
                "type" : "number",
                "description" : "Present when exactly one leg is fixed: the fixed rate that zeroes the\ntotal NPV, holding the floating leg and every notional exchange fixed.\nAbsent for float/float and fixed/fixed swaps."
              },
        "fair_spread" : {
                "type" : "number",
                "description" : "Present when both legs float: the spread on leg2 (by convention) that\nzeroes the total NPV, holding leg1 and every notional exchange fixed.\nAbsent when a leg is fixed."
              },
        "fx_spot_used" : {
                "type" : "number",
                "description" : "The spot rate the swap was priced with (quote units per base unit of\nthe referenced spot, for delivery on `spot_date`)."
              },
        "fx_as_of_rate" : {
                "type" : "number",
                "description" : "As-of exchange rate X = S * DF_quote(t_s) / DF_base(t_s) used to\nconvert between the two leg currencies (quote units per base unit of\nthe referenced spot)."
              },
        "spot_date" : {
                "type" : "string",
                "description" : "Spot date of the referenced spot: the (adjusted) evaluation date\nadvanced `spot_days` business days on its joint calendar, ISO."
              },
        "leg1_flows" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_SwapLegFlow"},
                "description" : "Future flows of leg1 in payment order (`include_flows`), in the leg's\nown frame: coupon amounts positive, the initial exchange -notional, the\nfinal exchange +notional; `kind` tells them apart. The sum of their\n`present_value`s is `leg1_npv / s_1`."
              },
        "leg2_flows" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_SwapLegFlow"},
                "description" : "Future flows of leg2 (`include_flows`), same conventions as `leg1_flows`."
              }
      },
      "additionalProperties" : false
    },
    "quantra_PriceCrossCurrencySwapResponse" : {
