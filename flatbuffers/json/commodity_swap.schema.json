    "quantra_CommodityPeriod" : {
      "type" : "object",
      "description" : "One calculation period. Both dates are included.",
      "properties" : {
        "start_date" : {
                "type" : "string",
                "description" : "First day of the period, included (YYYY-MM-DD). Required."
              },
        "end_date" : {
                "type" : "string",
                "description" : "Last day of the period, included (YYYY-MM-DD). On or after\n`start_date` (400 otherwise). Required."
              }
      },
      "required" : ["start_date", "end_date"],
      "additionalProperties" : false
    },
    "quantra_CommodityPeriods" : {
      "type" : "object",
      "description" : "The calculation periods of a commodity leg, in one of two forms; exactly\none is given (400 otherwise, including a mix of the two):\ngenerated: `start_date`, `end_date` and `frequency` all present, no\n`periods`;\nexplicit: only `periods`.\nDates are never adjusted for weekends or holidays: a period's pricing\ndays are read inside it from the pricing calendar.\nGenerated periods are calendar months, quarters, half-years or years\n(`frequency` Monthly, Quarterly, Semiannual, Annual), the first period\ncut to start at `start_date` and the last cut to end at `end_date`.\nExample: 2026-11-15 to 2027-03-31 Monthly gives 15-30 November, December,\nJanuary, February and March. `Once` gives one period from `start_date` to\n`end_date`. Any other frequency is a 400.",
      "properties" : {
        "start_date" : {
                "type" : "string",
                "description" : "Generated form: first day of the first period, included (YYYY-MM-DD)."
              },
        "end_date" : {
                "type" : "string",
                "description" : "Generated form: last day of the last period, included (YYYY-MM-DD)."
              },
        "frequency" : {
                "$ref" : "#/definitions/quantra_enums_Frequency",
                "description" : "Generated form: Monthly, Quarterly, Semiannual, Annual or Once."
              },
        "periods" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_CommodityPeriod"},
                "description" : "Explicit form: the periods in ascending order. They must not overlap;\ngaps between them are allowed."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CommodityQuantity" : {
      "type" : "object",
      "description" : "Quantity delivered by a commodity swap leg. The quantity is in the price\nunit of the contract or spot price it is priced against.",
      "properties" : {
        "value" : {
                "type" : "number",
                "description" : "One quantity for every period. Exactly one of `value` and `values`\nis given."
              },
        "values" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "One quantity per period, in period order. The count must equal the\nnumber of periods (400 otherwise)."
              },
        "basis" : {
                "$ref" : "#/definitions/quantra_enums_CommodityQuantityBasis",
                "description" : "Whether the quantity is per period or per pricing day.\nPresence-required."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CommodityFixedPrice" : {
      "type" : "object",
      "description" : "Fixed price of a commodity swap leg.",
      "properties" : {
        "price" : {
                "type" : "number",
                "description" : "One price for every period, per unit of the quantity. Exactly one of\n`price` and `prices` is given."
              },
        "prices" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "One price per period, in period order. The count must equal the\nnumber of periods (400 otherwise)."
              }
      },
      "additionalProperties" : false
    },
    "quantra_FuturesFloatingPrice" : {
      "type" : "object",
      "description" : "Floating price from a futures contract: the average, over the period's\npricing days, of the nearby contract's price; or, with `observation`\nOnePricePerPeriod, one price per period.",
      "properties" : {
        "contract_id" : {
                "type" : "string",
                "description" : "Id of a `pricing.commodity.contracts` entry. Required."
              },
        "nearby" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Which contract is read: 1 is the front month, 2 the next one.\nPresence-required with DailyAverage; a 400 with OnePricePerPeriod."
              },
        "roll_days_before_expiry" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "A pricing day rolls to the next contract this many pricing days\nbefore the last trading date: 0 reads the front month on its last\ntrading date. Presence-required with DailyAverage; a 400 with\nOnePricePerPeriod."
              },
        "spread" : {
                "type" : "number",
                "description" : "Added to each period's average, in price units. Defaults to 0."
              },
        "observation" : {
                "$ref" : "#/definitions/quantra_enums_CommodityFuturesObservation",
                "description" : "DailyAverage (the default): the average over the period's pricing\ndays. OnePricePerPeriod: one price per period, the contract month\ncontaining the period's last day read on the earlier of the payment\ndate and its last trading date (a quantity per pricing day on either\nleg is then a 400)."
              }
      },
      "required" : ["contract_id"],
      "additionalProperties" : false
    },
    "quantra_SpotFloatingPrice" : {
      "type" : "object",
      "description" : "Floating price from a spot assessment: the average, over the period's\npricing days, of the published price.",
      "properties" : {
        "spot_id" : {
                "type" : "string",
                "description" : "Id of a `pricing.commodity.spot_prices` entry. Required."
              },
        "spread" : {
                "type" : "number",
                "description" : "Added to each period's average, in price units. Defaults to 0."
              }
      },
      "required" : ["spot_id"],
      "additionalProperties" : false
    },
    "quantra_CommoditySwapLeg" : {
      "type" : "object",
      "description" : "One leg of a commodity swap.",
      "properties" : {
        "pay_receive" : {
                "$ref" : "#/definitions/quantra_enums_PayReceive",
                "description" : "Pay or receive this leg. The two legs must be opposite (400\notherwise). Presence-required."
              },
        "periods" : {
                "$ref" : "#/definitions/quantra_CommodityPeriods",
                "description" : "Calculation periods, generated or explicit (see `CommodityPeriods`).\nRequired."
              },
        "quantity" : {
                "$ref" : "#/definitions/quantra_CommodityQuantity",
                "description" : "Quantity of the leg, per period or per pricing day. Required."
              },
        "price_type" : {
                "$ref" : "#/definitions/quantra_CommodityLegPrice"
              },
        "price" : {
                "anyOf": [{ "$ref" : "#/definitions/quantra_CommodityFixedPrice" },{ "$ref" : "#/definitions/quantra_FuturesFloatingPrice" },{ "$ref" : "#/definitions/quantra_SpotFloatingPrice" }],
                "description" : "Fixed price or floating price definition. Required."
              },
        "payment_calendar" : {
                "$ref" : "#/definitions/quantra_enums_Calendar",
                "description" : "Calendar for the payment date. Presence-required."
              },
        "payment_lag" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Business days of `payment_calendar` after the period's end date to\nits payment date. Presence-required."
              },
        "payment_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention",
                "description" : "Business day convention of the payment date. Presence-required."
              },
        "discounting_curve" : {
                "type" : "string",
                "description" : "Id of a `pricing.rates.curves` curve the leg's payments are\ndiscounted on. Required. It decides the discounting; the caller is\nresponsible for it matching the currency of the prices supplied."
              }
      },
      "required" : ["periods", "quantity", "price", "discounting_curve"],
      "additionalProperties" : false
    },
    "quantra_CommoditySwap" : {
      "type" : "object",
      "description" : "Commodity swap: two legs, one paid and one received (`pay_receive`),\neach a fixed price or a floating price on futures or a spot assessment.",
      "properties" : {
        "leg1" : {
                "$ref" : "#/definitions/quantra_CommoditySwapLeg",
                "description" : "First leg. Required. Reported as `legs[0]`."
              },
        "leg2" : {
                "$ref" : "#/definitions/quantra_CommoditySwapLeg",
                "description" : "Second leg. Required. Reported as `legs[1]`."
              },
        "common_pricing" : {
                "type" : "boolean",
                "description" : "Two floating legs only (a 400 otherwise): a day is a pricing day of a\nperiod of either leg only when it is a pricing day of both legs'\ncontracts or spot prices. Default false: each leg averages over its\nown pricing days."
              }
      },
      "required" : ["leg1", "leg2"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_CommoditySwap"
}
