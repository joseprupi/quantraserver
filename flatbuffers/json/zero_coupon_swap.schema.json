    },
    "quantra_IndexDef" : {
      "type" : "object",
      "description" : "Complete index definition. Registered once per request, referenced by id.",
      "properties" : {
        "id" : {
                "type" : "string",
                "description" : "Unique identifier (e.g., \"EUR_6M\", \"USD_SOFR\", \"MY_CUSTOM_3M\")."
              },
        "name" : {
                "type" : "string",
                "description" : "Human-readable name / family label (e.g., \"Euribor\", \"SOFR\")."
              },
        "index_type" : {
                "$ref" : "#/definitions/quantra_IndexType",
                "description" : "IBOR or Overnight. Determines QuantLib class used."
              },
        "tenor" : {
                "$ref" : "#/definitions/quantra_Period",
                "description" : "Tenor period (e.g., 6 Months for Euribor 6M, 0 Days for overnight)."
              },
        "fixing_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Fixing days (e.g., 2 for Euribor, 0 for SOFR/ESTR)."
              },
        "calendar" : {
                "$ref" : "#/definitions/quantra_enums_Calendar",
                "description" : "Calendar for fixing/payment dates."
              },
        "business_day_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention",
                "description" : "Business day convention."
              },
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter",
                "description" : "Day count convention."
              },
        "end_of_month" : {
                "type" : "boolean",
                "description" : "End of month rule (IBOR only, ignored for overnight)."
              },
        "currency" : {
                "type" : "string",
                "description" : "ISO currency code (e.g., \"EUR\", \"USD\", \"GBP\", \"JPY\")."
              },
        "fixings" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Fixing"},
                "description" : "Past fixings needed for seasoned instruments."
              }
      },
      "required" : ["id", "name"],
      "additionalProperties" : false
    },
    "quantra_IndexRef" : {
      "type" : "object",
      "description" : "Reference to an IndexDef by its id.",
      "properties" : {
        "id" : {
                "type" : "string"
              }
      },
      "required" : ["id"],
      "additionalProperties" : false
    },
    "quantra_ZeroCouponSwap" : {
      "type" : "object",
      "description" : "Zero-coupon interest rate swap (QuantLib::ZeroCouponSwap). Exchanges a\nsingle fixed cashflow at maturity against a single compounded-floating\ncashflow. The fixed side is quoted EITHER as a known fixed payment amount\nOR as a fixed rate compounded over the contract life.",
      "properties" : {
        "swap_type" : {
                "$ref" : "#/definitions/quantra_enums_SwapType",
                "description" : "Payer/receiver refer to the fixed leg. Presence-required: an omitted\ntype is a 400, never the alphabetical-0 default (Payer)."
              },
        "base_nominal" : {
                "type" : "number",
                "description" : "Base notional prior to compounding."
              },
        "start_date" : {
                "type" : "string",
                "description" : "Contract start date (ISO yyyy-mm-dd)."
              },
        "maturity_date" : {
                "type" : "string",
                "description" : "Contract maturity / single-payment date (ISO yyyy-mm-dd)."
              },
        "fixed_payment" : {
                "type" : "number",
                "description" : "Fixed-payment form: the known fixed cash flow N^FIX. Optional; presence\nselects this quoting form. Exactly one of `fixed_payment` or the\n`fixed_rate`+`fixed_rate_day_counter` pair must be supplied."
              },
        "fixed_rate" : {
                "type" : "number",
                "description" : "Fixed-rate form: the fixed rate R compounded over the contract life as\nN^FIX = N[(1+R)^alpha - 1], alpha the fixed_rate_day_counter year\nfraction between start and maturity. Optional; presence selects this\nquoting form. QuantLib's ZeroCouponSwap rate constructor takes only the\nrate and its day counter (compounding is implicitly annual and there is\nno coupon frequency), so no compounding/frequency fields are exposed."
              },
        "fixed_rate_day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter",
                "description" : "Day counter for the fixed-rate compounding (alpha). Required when, and\nonly when, `fixed_rate` is supplied."
              },
        "index" : {
                "$ref" : "#/definitions/quantra_IndexRef",
                "description" : "Reference to an IndexDef by id for the floating leg (e.g. \"EUR_6M\")."
              },
        "payment_calendar" : {
                "$ref" : "#/definitions/quantra_enums_Calendar",
                "description" : "Calendar used to adjust the single payment date. Presence-required."
              },
        "payment_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention",
                "description" : "Business-day convention for the payment date. Presence-required."
              },
        "payment_delay" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Number of business days the payment is delayed after maturity."
              }
      },
      "required" : ["index"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_ZeroCouponSwap"
}
