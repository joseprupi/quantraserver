    "quantra_CommodityObservation" : {
      "type" : "object",
      "description" : "One price observed on a pricing day of a floating flow.",
      "properties" : {
        "date" : {
                "type" : "string",
                "description" : "Pricing day (YYYY-MM-DD)."
              },
        "contract_month" : {
                "type" : "string",
                "description" : "Delivery month of the contract read, \"YYYY-MM\". Absent for a price\nread from a spot assessment."
              },
        "price" : {
                "type" : "number",
                "description" : "The price observed."
              },
        "source" : {
                "$ref" : "#/definitions/quantra_enums_CommodityPriceSource",
                "description" : "Whether the price is a past fixing or read from today's market data."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CommodityFlow" : {
      "type" : "object",
      "description" : "One calculation period of a commodity swap leg.",
      "properties" : {
        "start_date" : {
                "type" : "string",
                "description" : "First day of the period (YYYY-MM-DD)."
              },
        "end_date" : {
                "type" : "string",
                "description" : "Last day of the period, included (YYYY-MM-DD)."
              },
        "payment_date" : {
                "type" : "string",
                "description" : "Payment date (YYYY-MM-DD)."
              },
        "pricing_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Number of pricing days in the period."
              },
        "realised_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Pricing days whose price is a fixing."
              },
        "average" : {
                "type" : "number",
                "description" : "Average price of the period, floating leg only (before the spread\nis added)."
              },
        "realised_average" : {
                "type" : "number",
                "description" : "Average of the realised days' prices. Absent when there are none."
              },
        "expected_average" : {
                "type" : "number",
                "description" : "Average of the days read from today's market data. Absent when there\nare none."
              },
        "spread" : {
                "type" : "number",
                "description" : "Floating leg only: the spread added to the average, repeated on every\nflow so each row is self-contained."
              },
        "price" : {
                "type" : "number",
                "description" : "Fixed price of the period, fixed leg only."
              },
        "quantity" : {
                "type" : "number",
                "description" : "Quantity of the period, in the price unit of the contract or spot price."
              },
        "amount" : {
                "type" : "number",
                "description" : "Signed payment amount, quantity times price, in the currency of the\nprices supplied: positive when received, negative when paid."
              },
        "discount" : {
                "type" : "number",
                "description" : "Discount factor from the payment date."
              },
        "present_value" : {
                "type" : "number",
                "description" : "Present value of the amount: amount * discount."
              },
        "observations" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_CommodityObservation"},
                "description" : "One entry per pricing day; only with `include_observations`."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CommoditySwapLegResult" : {
      "type" : "object",
      "description" : "Result of one commodity swap leg.",
      "properties" : {
        "npv" : {
                "type" : "number",
                "description" : "Signed present value of the leg: the sum of its\nflows' present values."
              },
        "flows" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_CommodityFlow"},
                "description" : "The leg's periods in payment order; only with `include_flows`."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CommodityPriceDelta" : {
      "type" : "object",
      "description" : "Sensitivity of the swap's NPV to one input price.",
      "properties" : {
        "contract_id" : {
                "type" : "string",
                "description" : "Contract id of a futures price. Absent on a spot price."
              },
        "month" : {
                "type" : "string",
                "description" : "Delivery month of the futures price, \"YYYY-MM\". Absent on a spot\nprice."
              },
        "spot_id" : {
                "type" : "string",
                "description" : "Spot id of a spot forward price. Absent on a futures price."
              },
        "date" : {
                "type" : "string",
                "description" : "Date of the spot forward price (YYYY-MM-DD). Absent on a futures\nprice."
              },
        "delta" : {
                "type" : "number",
                "description" : "Change of the swap's NPV per unit change of this price."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CommoditySwapResponse" : {
      "type" : "object",
      "description" : "Commodity swap pricing result, as of the valuation date. Each flow's\n`amount` is the leg's sign (-1 for `Pay`, +1 for `Receive`) times the\nperiod's quantity times its price (the fixed price, or the average plus\nthe spread); `present_value` is the amount times `discount`;\n`legs[i].npv` is the sum of the leg's present values and\n`npv = legs[0].npv + legs[1].npv`.",
      "properties" : {
        "npv" : {
                "type" : "number",
                "description" : "Total present value, in the currency of the prices supplied, positive\nin favour of the reported party."
              },
        "fair_fixed_price" : {
                "type" : "number",
                "description" : "The fixed price that zeroes `npv`, the floating leg held fixed.\nPresent only for a fixed leg against a floating leg."
              },
        "fair_spread" : {
                "type" : "number",
                "description" : "The spread on the second floating leg that zeroes `npv`. Present only\nfor a floating leg against a floating leg."
              },
        "legs" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_CommoditySwapLegResult"},
                "description" : "One result per leg, in request order (`leg1` then `leg2`)."
              },
        "deltas" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_CommodityPriceDelta"},
                "description" : "Sensitivities of `npv` to each input price used."
              }
      },
      "required" : ["legs"],
      "additionalProperties" : false
    },
    "quantra_PriceCommoditySwapResponse" : {
      "type" : "object",
      "description" : "Response wrapper for multiple commodity swaps, in request order.",
      "properties" : {
        "swaps" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_CommoditySwapResponse"}
              }
      },
      "required" : ["swaps"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_PriceCommoditySwapResponse"
}
