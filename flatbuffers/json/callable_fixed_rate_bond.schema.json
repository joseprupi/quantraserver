    "quantra_Schedule" : {
      "type" : "object",
      "description" : "Date schedule definition for payment and accrual dates.",
      "properties" : {
        "calendar" : {
                "$ref" : "#/definitions/quantra_enums_Calendar"
              },
        "effective_date" : {
                "type" : "string"
              },
        "termination_date" : {
                "type" : "string"
              },
        "frequency" : {
                "$ref" : "#/definitions/quantra_enums_Frequency"
              },
        "convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              },
        "termination_date_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              },
        "date_generation_rule" : {
                "$ref" : "#/definitions/quantra_enums_DateGenerationRule"
              },
        "end_of_month" : {
                "type" : "boolean"
              },
        "first_date" : {
                "type" : "string",
                "description" : "Optional. ISO-8601 (YYYY-MM-DD). When present, passed as QuantLib's\nfirstDate, which controls the FIRST stub coupon: with Backward date\ngeneration a first_date after effective_date creates a short/long first\nperiod; with Forward generation it anchors the regular periods. Must lie\nstrictly between effective_date and termination_date. Omit for no first\nstub (bit-identical to prior behaviour)."
              },
        "next_to_last_date" : {
                "type" : "string",
                "description" : "Optional. ISO-8601 (YYYY-MM-DD). When present, passed as QuantLib's\nnextToLastDate, controlling the LAST stub coupon symmetrically to\nfirst_date. Must lie strictly between effective_date and\ntermination_date (and, when first_date is also present, on or after it).\nOmit for no last stub (bit-identical to prior behaviour)."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CallabilityEntry" : {
      "type" : "object",
      "description" : "One entry in a callable/puttable bond's call schedule: on `date` the option\nholder (the issuer for a Call, the bondholder for a Put) may exercise at\n`price`.\n\n`price` is a CLEAN price per 100 of face — it maps to a QuantLib\nCallability::Price of type Clean (Bond::Price::Clean). Dirty-price call\nschedules are equally native in QuantLib, but this product ships Clean-only;\na `price_type` selector is a documented future extension. `price` must be\nstrictly positive.",
      "properties" : {
        "date" : {
                "type" : "string",
                "description" : "Exercise date (YYYY-MM-DD)."
              },
        "price" : {
                "type" : "number",
                "description" : "Clean call/put price per 100 of face. Must be > 0."
              },
        "callability_type" : {
                "$ref" : "#/definitions/quantra_enums_CallabilityType",
                "description" : "Option side: Call (issuer redeems) or Put (holder sells back).\nPresence-required — there is no alphabetical-0 default."
              }
      },
      "additionalProperties" : false
    },
    "quantra_CallableFixedRateBond" : {
      "type" : "object",
      "description" : "Callable (or puttable) fixed-rate bond. Mirrors the plain FixedRateBond\ncoupon vocabulary (settlement_days, face_amount, single coupon rate,\naccrual_day_counter, payment_convention, redemption, issue_date, schedule)\nand adds a non-empty call schedule. Priced with a short-rate (Hull-White)\nmodel on a trinomial tree lattice. Per-period amortizing notionals are a\ndocumented future extension (QuantLib's CallableFixedRateBond is\nconstant-notional).",
      "properties" : {
        "settlement_days" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "face_amount" : {
                "type" : "number",
                "description" : "Face amount. Presence-required and must be > 0 (a bare double would\ndefault to a silent zero face)."
              },
        "rate" : {
                "type" : "number"
              },
        "accrual_day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter"
              },
        "payment_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention"
              },
        "redemption" : {
                "type" : "number"
              },
        "issue_date" : {
                "type" : "string"
              },
        "schedule" : {
                "$ref" : "#/definitions/quantra_Schedule"
              },
        "call_schedule" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_CallabilityEntry"},
                "description" : "Non-empty call/put schedule. Entries must carry strictly increasing\ndates, each after issue_date, and each with price > 0."
              }
      },
      "required" : ["call_schedule"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_CallableFixedRateBond"
}
