    "quantra_YoYInflationCapFloor" : {
      "type" : "object",
      "description" : "Year-on-year inflation cap / floor / collar (QuantLib::YoYInflationCapFloor).\nA strip of year-on-year inflation optionlets built over `schedule` off the\nsame YoY inflation index/curve the year-on-year inflation swap path uses.\n\nThe pricing formula is selected by the referenced YoYOptionletVolSpec's\nvol_type (Black / UnitDisplacedBlack / Bachelier); the vol surface and this\ninstrument reference the SAME year-on-year inflation index by id.",
      "properties" : {
        "cap_floor_type" : {
                "$ref" : "#/definitions/quantra_enums_CapFloorType",
                "description" : "Cap, Floor, or Collar. Presence-required: an omitted type is a 400,\nnever the alphabetical-0 default (Cap). Reuses the shared CapFloorType\nenum (Cap/Floor/Collar)."
              },
        "notional" : {
                "type" : "number",
                "description" : "Notional per optionlet."
              },
        "schedule" : {
                "$ref" : "#/definitions/quantra_Schedule",
                "description" : "Coupon schedule for the year-on-year optionlet strip."
              },
        "inflation_index_id" : {
                "type" : "string",
                "description" : "Link to InflationIndexSpec.id — the YoY inflation index (must resolve to\na QuantLib YoYInflationIndex, same as the year-on-year inflation swap)."
              },
        "observation_lag" : {
                "$ref" : "#/definitions/quantra_Period",
                "description" : "Observation lag used when the year-on-year rate is observed (e.g. 3\nMonths)."
              },
        "day_counter" : {
                "$ref" : "#/definitions/quantra_enums_DayCounter",
                "description" : "Day counter for the optionlet accrual. Presence-required."
              },
        "payment_convention" : {
                "$ref" : "#/definitions/quantra_enums_BusinessDayConvention",
                "description" : "Business-day convention for the payment dates. Presence-required."
              },
        "cap_rate" : {
                "type" : "number",
                "description" : "Cap strike (year-on-year rate). Required when, and only when, the type\nis Cap or Collar; must be absent for a Floor."
              },
        "floor_rate" : {
                "type" : "number",
                "description" : "Floor strike (year-on-year rate). Required when, and only when, the type\nis Floor or Collar; must be absent for a Cap. For a Collar,\ncap_rate >= floor_rate is enforced."
              },
        "gearing" : {
                "type" : "number",
                "description" : "Optional per-optionlet gearing on the year-on-year rate (absent => 1.0)."
              },
        "spread" : {
                "type" : "number",
                "description" : "Optional per-optionlet spread added to the year-on-year rate\n(absent => 0.0)."
              }
      },
      "required" : ["schedule", "observation_lag"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_YoYInflationCapFloor"
}
