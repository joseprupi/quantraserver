              },
        "discount" : {
                "type" : "number"
              },
        "rate" : {
                "type" : "number"
              },
        "price" : {
                "type" : "number"
              }
      },
      "additionalProperties" : false
    },
    "quantra_FlowPastInterest" : {
      "type" : "object",
      "description" : "Past fixed interest cash flow.",
      "properties" : {
        "amount" : {
                "type" : "number"
              },
        "fixing_date" : {
                "type" : "string"
              },
        "accrual_start_date" : {
                "type" : "string"
              },
        "accrual_end_date" : {
                "type" : "string"
              },
        "rate" : {
                "type" : "number"
              }
      },
      "additionalProperties" : false
    },
    "quantra_FlowNotional" : {
      "type" : "object",
      "description" : "Notional exchange cash flow.",
      "properties" : {
        "date" : {
                "type" : "string"
              },
        "amount" : {
                "type" : "number"
              },
        "discount" : {
                "type" : "number"
              },
        "price" : {
                "type" : "number"
              }
      },
