    },
    "quantra_FlowsWrapper" : {
      "type" : "object",
      "description" : "Wrapper for a single flow in a collection.",
      "properties" : {
        "flow_type" : {
                "$ref" : "#/definitions/quantra_Flow"
              },
        "flow" : {
                "anyOf": [{ "$ref" : "#/definitions/quantra_FlowInterest" },{ "$ref" : "#/definitions/quantra_FlowPastInterest" },{ "$ref" : "#/definitions/quantra_FlowNotional" }]
              }
      },
      "additionalProperties" : false
    },
    "quantra_SabrCalibrationDiagnostics" : {
      "type" : "object",
      "description" : "Calibration-specific diagnostics. Populated only for SABR surfaces whose\nkind is SabrCalibrate. For SabrParams surfaces (and other kinds in future\nextensions) this sub-block is absent on the parent SwaptionVolDiagnostics.",
      "properties" : {
        "per_node_rmse" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Root-mean-square fit error per (expiry, tenor) node, row-major nExp*nTen."
              },
        "per_node_max_abs_error" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Worst single-strike absolute error per (expiry, tenor) node, row-major nExp*nTen."
              },
        "overall_rmse" : {
                "type" : "number",
                "description" : "Aggregate RMSE across the entire cube."
              },
        "converged" : {
                "type" : "boolean",
                "description" : "True iff every node converged to a stationary point (i.e., end criteria\nis not None and not MaxIterations on any node)."
              },
        "iterations_per_node" : {
                "type" : "array", "items" : {"type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647},
                "description" : "Iteration count per node. Sentinel -1 indicates \"not exposed by the\noptimizer\" — current QuantLib (1.41) does not expose this publicly from\nthe SABR interpolator, so v1 always emits -1. Field is retained for\nschema forward-compatibility."
              },
        "strikes" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Strike spreads used in calibration (rate units, e.g. -0.02 = -200bp).\nSame vector applied at every (expiry, tenor) node."
              },
        "per_strike_fit_error" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-strike fit error (fitted - market) for each (expiry, tenor, strike).\nRow-major nExp*nTen*nStrikes."
              }
      },
      "additionalProperties" : false
    },
    "quantra_SwaptionVolDiagnostics" : {
      "type" : "object",
      "description" : "Diagnostics block describing one swaption vol surface. Emitted opt-in by\n/sample-vol-surfaces and /price-swaption when include_diagnostics=true, and\nreused as the response body for the standalone /calibrate-swaption-vol\nendpoint (Step 9).",
      "properties" : {
        "vol_id" : {
                "type" : "string",
                "description" : "Matches Pricing.volatility.vol_surfaces[].id."
              },
        "kind" : {
                "$ref" : "#/definitions/quantra_enums_SwaptionVolKind",
                "description" : "Resolved swaption vol kind for the surface."
              },
        "expiries" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Period"},
                "description" : "Per-node grid axes, mirroring the surface's pillars."
              },
        "tenors" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_Period"}
              },
        "n_expiries" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "n_tenors" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647
              },
        "forward_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-node forwards F(expiry, tenor), populated when handle is built.\nRow-major nExp*nTen."
              },
        "atm_vol_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Per-node ATM vols sigma(F) evaluated via Hagan. Row-major nExp*nTen."
              },
        "time_to_expiry_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "Time-to-expiry in years for each node. Row-major nExp*nTen."
              },
        "alpha_per_node" : {
                "type" : "array", "items" : {"type" : "number"},
                "description" : "SABR parameters in effect at each node. For SabrParams these are the\nuser-supplied values; for SabrCalibrate these are calibrator output.\nRow-major nExp*nTen, schema field order alpha, beta, rho, nu."
              },
        "beta_per_node" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "rho_per_node" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "nu_per_node" : {
                "type" : "array", "items" : {"type" : "number"}
              },
        "calibration" : {
                "$ref" : "#/definitions/quantra_SabrCalibrationDiagnostics",
                "description" : "Calibration sub-block. Present only for SabrCalibrate; absent for\nSabrParams (and other kinds in future extensions)."
              },
        "warnings" : {
                "type" : "array", "items" : {"type" : "string"},
                "description" : "Validation warnings. Empty when fit is healthy."
              }
      },
      "required" : ["vol_id"],
      "additionalProperties" : false
    },
    "quantra_SwaptionResponse" : {
      "type" : "object",
      "description" : "Swaption pricing response with NPV, Greeks, and diagnostics.",
      "properties" : {
        "npv" : {
                "type" : "number",
                "description" : "Present value of the swaption under the selected model and market inputs."
              },
        "implied_volatility" : {
                "type" : "number",
                "description" : "Implied volatility reported by the engine. For non-constant vol setups this may be a best-effort value."
              },
        "atm_forward" : {
                "type" : "number",
                "description" : "ATM forward swap rate used for pricing diagnostics."
              },
        "annuity" : {
                "type" : "number",
                "description" : "Underlying swap annuity (PV01-style quantity)."
              },
        "delta" : {
                "type" : "number",
                "description" : "Option delta from pricing details/rebump logic."
              },
        "vega" : {
                "type" : "number",
                "description" : "Option vega from pricing details/rebump logic."
              },
        "gamma" : {
                "type" : "number",
                "description" : "Option gamma from pricing details/rebump logic."
              },
        "theta" : {
                "type" : "number",
                "description" : "Option theta from pricing details/rebump logic."
              },
        "dv01" : {
                "type" : "number",
                "description" : "1bp rate sensitivity. May be analytic or rebump-based depending on request flags."
              },
        "used_volatility" : {
                "type" : "number",
                "description" : "Volatility actually queried from the resolved vol surface."
              },
        "used_option_expiry" : {
                "type" : "string",
                "description" : "Option expiry date used by surface lookup (ISO date)."
              },
        "used_swap_tenor" : {
                "type" : "string",
                "description" : "Swap tenor descriptor used by lookup (e.g., date range)."
              },
        "used_strike" : {
                "type" : "number",
                "description" : "Strike used to query the volatility structure."
              },
        "used_atm_forward" : {
                "type" : "number",
                "description" : "ATM forward used when smile conventions need ATM anchoring."
              },
        "used_strike_kind" : {
                "$ref" : "#/definitions/quantra_enums_SwaptionStrikeKind",
                "description" : "Strike convention used by the source swaption vol surface."
              },
        "used_spread_from_atm" : {
                "type" : "number",
                "description" : "Difference between used strike and cube ATM level when spread-from-ATM is active."
              },
        "used_cube_node_atm" : {
                "type" : "number",
                "description" : "ATM level retrieved from cube node when available."
              },
        "vol_kind" : {
                "$ref" : "#/definitions/quantra_enums_SwaptionVolKind",
                "description" : "Resolved swaption volatility kind used by pricing."
              },
        "used_model_param_mode" : {
                "$ref" : "#/definitions/quantra_enums_ModelParamMode",
                "description" : "Effective model parameter mode used by the swaption engine."
              },
        "used_hw_a" : {
                "type" : "number",
                "description" : "Effective Hull-White mean reversion \"a\" used by pricing. -1.0 when model is not HullWhiteLattice."
              },
        "used_hw_sigma" : {
                "type" : "number",
                "description" : "Effective Hull-White sigma used by pricing. -1.0 when model is not HullWhiteLattice."
              },
        "used_hw_rmse" : {
                "type" : "number",
                "description" : "Calibration RMSE for inline-calibrated Hull-White. -1.0 when no inline calibration."
              },
        "used_hw_num_helpers" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Number of calibration helpers for inline-calibrated Hull-White. -1 when no inline calibration."
              },
        "used_hw_grid_rows" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Calibration grid rows for inline-calibrated Hull-White. -1 when no inline calibration."
              },
        "used_hw_grid_cols" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Calibration grid columns for inline-calibrated Hull-White. -1 when no inline calibration."
              },
        "used_hw_grid_points" : {
                "type" : "integer", "minimum" : -2147483648, "maximum" : 2147483647,
                "description" : "Calibration grid points for inline-calibrated Hull-White. -1 when no inline calibration."
              }
      },
      "additionalProperties" : false
    },
    "quantra_PriceSwaptionResponse" : {
      "type" : "object",
      "description" : "Response wrapper for multiple swaptions.",
      "properties" : {
        "swaptions" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_SwaptionResponse"}
              },
        "diagnostics" : {
                "type" : "array", "items" : {"$ref" : "#/definitions/quantra_SwaptionVolDiagnostics"},
                "description" : "Per-surface diagnostics, one entry per unique SABR-kind vol surface\nreferenced by the priced swaptions. Populated only when the request\nsets `include_diagnostics=true`. Empty/absent otherwise."
              }
      },
      "required" : ["swaptions"],
      "additionalProperties" : false
    }
  },
  "$ref" : "#/definitions/quantra_PriceSwaptionResponse"
}
