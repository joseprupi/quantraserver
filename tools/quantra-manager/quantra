# ----------------------------
# Helpers: filesystem
# ----------------------------
def ensure_state_dir():
    """Create state/log directories if they don't exist."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)


# ----------------------------
# Helpers: binaries
# ----------------------------
def find_quantra_binary() -> Optional[Path]:
    """Find the sync_server binary."""
    candidates = [
        Path(QUANTRA_HOME) / "build" / "server" / "sync_server",
        Path("/workspace/build/server/sync_server"),
        Path("./build/server/sync_server"),
    ]

    for candidate in candidates:
        if candidate.exists() and candidate.is_file():
            return candidate

    # Try PATH
    result = subprocess.run(["which", "sync_server"], capture_output=True, text=True)
    if result.returncode == 0:
        return Path(result.stdout.strip())

    return None


def find_envoy_binary() -> Optional[Path]:
    """Find the envoy binary."""
    result = subprocess.run(["which", "envoy"], capture_output=True, text=True)
    if result.returncode == 0:
        return Path(result.stdout.strip())
    return None


# ----------------------------
# Helpers: ports
# ----------------------------
def _port_in_use(port: int) -> bool:
    """
    Check if a TCP port is in use (best-effort).
    Prefers `ss`, falls back to bind test.
    """
    # Try ss
    try:
        r = subprocess.run(["ss", "-lnt"], capture_output=True, text=True)
        if r.returncode == 0:
            return f":{port} " in r.stdout or f":{port}\n" in r.stdout
    except Exception:
        pass

    # Fallback: bind test
    import socket
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        # Envoy and the workers bind with SO_REUSEADDR, so connections of an
        # earlier run still closing on the port (TIME_WAIT) do not stop them.
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("0.0.0.0", port))
        return False
    except OSError:
        return True
    finally:
        try:
            s.close()
        except Exception:
            pass


def preflight_ports(port: int, base_port: int, workers: int, admin_port: int, extra=()):
    needed = [port, admin_port] + list(range(base_port, base_port + workers)) + list(extra)
    conflicts = [p for p in needed if _port_in_use(p)]
    if conflicts:
        print("Error: Some required ports are already in use:", file=sys.stderr)
        for p in conflicts:
            print(f"  - {p}", file=sys.stderr)
        print("\nTip: run `quantra stop --force` or change ports.", file=sys.stderr)
        sys.exit(1)


# ----------------------------
# Envoy config generation
# ----------------------------
DEFAULT_ROUTE_TIMEOUT_MS = 30000


def envoy_duration(ms: int) -> str:
    """Milliseconds as an Envoy duration string: 30000 -> "30s", 1500 -> "1.5s"."""
    if ms % 1000 == 0:
        return f"{ms // 1000}s"
    return f"{ms / 1000:.3f}".rstrip("0") + "s"


def route_timeout_from_env(environ=None) -> str:
    """Envoy route timeout from QUANTRA_ROUTE_TIMEOUT_MS (default 30000 ms).

    A non-positive or unparseable value logs one line to stderr and keeps the
    default. Kept in lockstep with the inline copy in scripts/envoy_config.py.
    """
    env = os.environ if environ is None else environ
    raw = str(env.get("QUANTRA_ROUTE_TIMEOUT_MS", "")).strip()
    ms = DEFAULT_ROUTE_TIMEOUT_MS
    if raw:
        try:
            value = int(raw)
        except ValueError:
            value = 0
        if value > 0:
            ms = value
        else:
            print(f"QUANTRA_ROUTE_TIMEOUT_MS={raw!r} is not a positive integer; "
                  f"using {DEFAULT_ROUTE_TIMEOUT_MS} ms", file=sys.stderr)
    return envoy_duration(ms)


DEFAULT_GRPC_TIMEOUT_HEADER_MAX_MS = 60000


def duration_ms(duration: str) -> float:
    """An Envoy duration string ("30s", "1.5s", "250ms") in milliseconds."""
    d = duration.strip()
    if d.endswith("ms"):
        return float(d[:-2])
    if d.endswith("s"):
        return float(d[:-1]) * 1000.0
    raise ValueError(f"not an Envoy duration in s or ms: {duration!r}")


def grpc_timeout_header_max_for(route_timeout: str) -> str:
    """Cap on a caller's grpc-timeout header: max(60s, route timeout).

    For gRPC requests Envoy uses the caller's grpc-timeout header (capped
    here) instead of the route timeout, so a route timeout above 60s only
    takes effect for gRPC traffic when the cap follows it. Kept in lockstep
    with the inline copy in scripts/envoy_config.py.
    """
    ms = max(DEFAULT_GRPC_TIMEOUT_HEADER_MAX_MS, duration_ms(route_timeout))
    return envoy_duration(int(round(ms)))


def least_request_choice_count(workers: int) -> int:
    # Kept in lockstep with scripts/envoy_config.py.
    return max(2, 4 * workers)


# --- BEGIN load control (identical in scripts/envoy_config.py and tools/quantra-manager/quantra) ---
# Optional knobs on the generated Envoy config. With none of them set the
# config is exactly the one generated before they existed (a golden test
# holds that). Each knob is a keyword argument of generate_envoy_config and an
# environment variable; an explicit argument wins over the variable.
DEFAULT_MAX_REQUESTS = 10000
DEFAULT_MAX_PENDING = 10000
DEFAULT_RETRIES = 0
DEFAULT_STATS_PORT = 9902
WORKERS_CLUSTER = "quantra_workers"
META_CLUSTER = "quantra_meta"
ADMIN_CLUSTER = "envoy_admin"
META_RPC_PATH = "/quantra.QuantraServer/Meta"


def _int_knob(environ, name: str, default: int, minimum: int, maximum: Optional[int] = None) -> int:
    """An integer environment knob: unset or empty keeps the default; a value
    that is not an integer in [minimum, maximum] logs one line and keeps it."""
    raw = str(environ.get(name, "")).strip()
    if not raw:
        return default
    try:
        value = int(raw)
    except ValueError:
        value = None
    if value is None or value < minimum or (maximum is not None and value > maximum):
        bound = f">= {minimum}" if maximum is None else f"in [{minimum}, {maximum}]"
        print(f"{name}={raw!r} is not an integer {bound}; using {default}", file=sys.stderr)
        return default
    return value


def load_control_from_env(environ=None) -> Dict[str, Any]:
    """The load-control knobs read from QUANTRA_MAX_REQUESTS,
    QUANTRA_MAX_PENDING, QUANTRA_RETRIES, QUANTRA_STATS_BIND and
    QUANTRA_STATS_PORT."""
    env = os.environ if environ is None else environ
    return {
        "max_requests": _int_knob(env, "QUANTRA_MAX_REQUESTS", DEFAULT_MAX_REQUESTS, 1),
        "max_pending": _int_knob(env, "QUANTRA_MAX_PENDING", DEFAULT_MAX_PENDING, 1),
        "retries": _int_knob(env, "QUANTRA_RETRIES", DEFAULT_RETRIES, 0),
        "stats_bind": str(env.get("QUANTRA_STATS_BIND", "")).strip() or None,
        "stats_port": _int_knob(env, "QUANTRA_STATS_PORT", DEFAULT_STATS_PORT, 1, 65535),
    }


def resolve_load_control(max_requests=None, max_pending=None, retries=None,
                         stats_bind=None, stats_port=None, environ=None) -> Dict[str, Any]:
    """Explicit arguments over environment knobs over defaults."""
    knobs = load_control_from_env(environ)
    for key, value in (("max_requests", max_requests), ("max_pending", max_pending),
                       ("retries", retries), ("stats_bind", stats_bind),
                       ("stats_port", stats_port)):
        if value is not None:
            knobs[key] = value
    if knobs["max_requests"] < 1 or knobs["max_pending"] < 1:
        raise ValueError("max_requests and max_pending must be >= 1")
    if knobs["retries"] < 0:
        raise ValueError("retries must be >= 0")
    if not 1 <= knobs["stats_port"] <= 65535:
        raise ValueError("stats_port must be in [1, 65535]")
    return knobs


def _router_filter() -> Dict[str, Any]:
    return {
        "name": "envoy.filters.http.router",
        "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
        },
    }


def apply_load_control(config: Dict[str, Any], knobs: Dict[str, Any], admin_port: int) -> Dict[str, Any]:
    """Apply the load-control knobs to a generated config, in place.

    - max_requests (other than the default): the workers cluster refuses a call
      over the limit at once. Envoy's own answer to that refusal (response flag
      UO, "upstream overflow") is rewritten to grpc-status 8
      RESOURCE_EXHAUSTED and HTTP 429, so the JSON gateway answers 429. The
      remaining-capacity gauges are tracked. The Meta RPC is routed to a
      second cluster on the same workers with the default limits, so the
      pricing limit never refuses it.
    - max_pending: the plain max_pending_requests breaker. It covers calls
      waiting for a connection to a worker; it does not queue calls for a busy
      worker.
    - retries (> 0): a call whose worker dies or cannot be reached is resent
      to another worker. Envoy does not retry its own overflow refusal, and a
      busy worker returns no error, so neither is retried.
    - stats_bind: an extra listener on stats_bind:stats_port that serves only
      GET /stats/prometheus and GET /ready from the admin interface (which
      itself stays on 127.0.0.1); every other path answers 404.
    """
    resources = config["static_resources"]
    listener = resources["listeners"][0]
    hcm = listener["filter_chains"][0]["filters"][0]["typed_config"]
    routes = hcm["route_config"]["virtual_hosts"][0]["routes"]
    workers = resources["clusters"][0]
    thresholds = workers["circuit_breakers"]["thresholds"][0]

    thresholds["max_pending_requests"] = knobs["max_pending"]

    if knobs["max_requests"] != DEFAULT_MAX_REQUESTS:
        meta = copy.deepcopy(workers)
        meta["name"] = META_CLUSTER
        meta["load_assignment"]["cluster_name"] = META_CLUSTER
        meta["circuit_breakers"]["thresholds"][0]["max_requests"] = DEFAULT_MAX_REQUESTS
        thresholds["max_requests"] = knobs["max_requests"]
        thresholds["track_remaining"] = True
        hcm["local_reply_config"] = {
            "mappers": [{
                "filter": {"response_flag_filter": {"flags": ["UO"]}},
                "status_code": 429,
                "headers_to_add": [{
                    "header": {"key": "grpc-status", "value": "8"},
                    "append_action": "OVERWRITE_IF_EXISTS_OR_ADD",
                }],
            }]
        }
        meta_route = copy.deepcopy(routes[0])
        meta_route["match"] = {"path": META_RPC_PATH}
        meta_route["route"]["cluster"] = META_CLUSTER
        routes.insert(0, meta_route)
        resources["clusters"].append(meta)

    if knobs["retries"] > 0:
        for route in routes:
            route["route"]["retry_policy"] = {
                "retry_on": "reset,connect-failure",
                "num_retries": knobs["retries"],
                "retry_host_predicate": [{
                    "name": "envoy.retry_host_predicates.previous_hosts",
                    "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.retry.host.previous_hosts.v3.PreviousHostsPredicate"
                    },
                }],
                "host_selection_retry_max_attempts": 5,
            }

    if knobs["stats_bind"]:
        get_only = [{"name": ":method", "string_match": {"exact": "GET"}}]
        resources["listeners"].append({
            "name": "quantra_stats_listener",
            "address": {
                "socket_address": {"address": knobs["stats_bind"], "port_value": knobs["stats_port"]}
            },
            "filter_chains": [{
                "filters": [{
                    "name": "envoy.filters.network.http_connection_manager",
                    "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                        "codec_type": "AUTO",
                        "stat_prefix": "quantra_stats",
                        "route_config": {
                            "name": "stats_route",
                            "virtual_hosts": [{
                                "name": "quantra_stats",
                                "domains": ["*"],
                                "routes": [
                                    {"match": {"path": path, "headers": get_only},
                                     "route": {"cluster": ADMIN_CLUSTER}}
                                    for path in ("/stats/prometheus", "/ready")
                                ],
                            }],
                        },
                        "http_filters": [_router_filter()],
                    },
                }],
            }],
        })
        resources["clusters"].append({
            "name": ADMIN_CLUSTER,
            "connect_timeout": "0.25s",
            "type": "STATIC",
            "load_assignment": {
                "cluster_name": ADMIN_CLUSTER,
                "endpoints": [{"lb_endpoints": [{"endpoint": {"address": {
                    "socket_address": {"address": "127.0.0.1", "port_value": admin_port}
                }}}]}],
            },
        })
    return config
# --- END load control ---


def generate_envoy_config(port: int, base_port: int, workers: int, admin_port: int,
                          route_timeout: Optional[str] = None,
                          max_requests: Optional[int] = None,
                          max_pending: Optional[int] = None,
                          retries: Optional[int] = None,
                          stats_bind: Optional[str] = None,
                          stats_port: Optional[int] = None) -> dict:
    knobs = resolve_load_control(max_requests, max_pending, retries, stats_bind, stats_port)
    return apply_load_control(
        _base_envoy_config(port, base_port, workers, admin_port, route_timeout), knobs, admin_port)


def _base_envoy_config(port: int, base_port: int, workers: int, admin_port: int,
                       route_timeout: Optional[str] = None) -> dict:
    if route_timeout is None:
        route_timeout = route_timeout_from_env()
    grpc_timeout_header_max = grpc_timeout_header_max_for(route_timeout)
    endpoints = []
    for i in range(workers):
        endpoints.append({
            "endpoint": {
                "address": {
                    "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": base_port + i
                    }
                }
            }
        })

    return {
        "admin": {
            "address": {
                "socket_address": {
                    "address": "127.0.0.1",
                    "port_value": admin_port
                }
            }
        },
        "static_resources": {
            "listeners": [{
                "name": "quantra_listener",
                "address": {
                    "socket_address": {"address": "0.0.0.0", "port_value": port}
                },
                "filter_chains": [{
                    "filters": [{
                        "name": "envoy.filters.network.http_connection_manager",
                        "typed_config": {
                            "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                            "codec_type": "AUTO",
                            "stat_prefix": "quantra_grpc",
                            "route_config": {
                                "name": "local_route",
                                "virtual_hosts": [{
                                    "name": "quantra_service",
                                    "domains": ["*"],
                                    "routes": [{
                                        "match": {"prefix": "/"},
                                        "route": {
                                            "cluster": "quantra_workers",
                                            "timeout": route_timeout,
                                            "max_stream_duration": {"grpc_timeout_header_max": grpc_timeout_header_max},
                                        },
                                    }],
                                }],
                            },
                            "http_filters": [{
                                "name": "envoy.filters.http.router",
                                "typed_config": {
                                    "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                                },
                            }],
                        },
                    }],
                }],
            }],
            "clusters": [{
                "name": "quantra_workers",
                "connect_timeout": "0.25s",
                "type": "STATIC",
                # Route around busy single-threaded workers: LEAST_REQUEST
                # samples choice_count workers at random (with replacement)
                # and picks the least loaded; Envoy 1.28 has no full scan and
                # samples 2 by default.
                "lb_policy": "LEAST_REQUEST",
                "least_request_lb_config": {
                    "choice_count": least_request_choice_count(workers)
                },
                "typed_extension_protocol_options": {
                    "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
                        "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
                        "explicit_http_config": {"http2_protocol_options": {}},
                    }
                },
                "circuit_breakers": {
                    "thresholds": [{
                        "priority": "DEFAULT",
                        "max_connections": 10000,
                        "max_requests": 10000,
                        "max_pending_requests": 10000,
                    }]
                },
                "health_checks": [{
                    "timeout": "1s",
                    "interval": "1s",
                    "unhealthy_threshold": 2,
                    "healthy_threshold": 1,
                    # gRPC health check against the standard grpc.health.v1.Health
                    # service the engine serves. Empty service name = overall
                    # serving status. A worker busy on a computation still answers
                    # (health runs on gRPC's own threads), so only dead workers are
                    # ejected.
                    "grpc_health_check": {},
                }],
                "load_assignment": {
                    "cluster_name": "quantra_workers",
                    "endpoints": [{"lb_endpoints": endpoints}],
                },
            }],
        },
    }


# ----------------------------
# PID file handling
# ----------------------------
def save_pids(pids: Dict[str, Any]):
    ensure_state_dir()
    with open(PID_FILE, "w") as f:
        json.dump(pids, f, indent=2)


def load_pids() -> Optional[Dict[str, Any]]:
    if not PID_FILE.exists():
        return None
    with open(PID_FILE, "r") as f:
        return json.load(f)


def is_process_running(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


# ----------------------------
# Process helpers
# ----------------------------
def _preexec_detach_ignore_hup():
    # Ignore SIGHUP in child (docker exec / PTY lifecycle can send it)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)


def _open_log(path: Path):
    ensure_state_dir()
    # append, line-buffered
    return open(path, "a", buffering=1)


def start_workers(binary: Path, base_port: int, workers: int, detach: bool) -> List[Dict[str, Any]]:
    processes: List[Dict[str, Any]] = []

    for i in range(workers):
        port = base_port + i
        log = _open_log(LOG_DIR / f"worker_{port}.log")

        popen_kwargs: Dict[str, Any] = dict(
            stdout=log,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
            close_fds=True,
        )
        if detach:
            popen_kwargs.update(start_new_session=True, preexec_fn=_preexec_detach_ignore_hup)

        proc = subprocess.Popen([str(binary), str(port)], **popen_kwargs)
        processes.append({"port": port, "pid": proc.pid})
        print(f"  Started worker on port {port} (PID: {proc.pid})")

    return processes


def start_envoy(config_path: Path, detach: bool) -> subprocess.Popen:
    envoy_binary = find_envoy_binary()
    if not envoy_binary:
        print("Error: envoy not found in PATH", file=sys.stderr)
        sys.exit(1)

    log = _open_log(LOG_DIR / "envoy.log")

    popen_kwargs: Dict[str, Any] = dict(
        stdout=log,
        stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL,
        close_fds=True,
    )
    if detach:
        popen_kwargs.update(start_new_session=True, preexec_fn=_preexec_detach_ignore_hup)

    return subprocess.Popen([str(envoy_binary), "-c", str(config_path), "--log-level", "warn"], **popen_kwargs)


def _terminate_pid(pid: int, name: str, force: bool, timeout_s: float = 3.0):
    if not pid or not is_process_running(pid):
        return

    try:
        print(f"  Stopping {name} (PID: {pid})...")
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return

    t0 = time.time()
    while time.time() - t0 < timeout_s:
        # A worker or Envoy started by this process stays a zombie (and looks
        # alive to kill(pid, 0)) until it is reaped.
        try:
            os.waitpid(pid, os.WNOHANG)
        except ChildProcessError:
            pass
        if not is_process_running(pid):
            return
        time.sleep(0.1)

    if force and is_process_running(pid):
        try:
            print(f"  {name} did not stop; sending SIGKILL (PID: {pid})...")
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass


# ----------------------------
# A caller-supplied Envoy config (--envoy-config / QUANTRA_ENVOY_CONFIG)
# ----------------------------
def validate_envoy_config_file(config_path: Path) -> None:
    """Run `envoy --mode validate` on the file; print Envoy's error and exit 1 when it fails."""
    envoy_binary = find_envoy_binary()
    if not envoy_binary:
        print("Error: envoy not found in PATH", file=sys.stderr)
        sys.exit(1)
    if not config_path.is_file():
        print(f"Error: Envoy config {config_path} not found", file=sys.stderr)
        sys.exit(1)
    result = subprocess.run(
        [str(envoy_binary), "--mode", "validate", "-c", str(config_path), "--log-level", "error"],
        capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: Envoy rejected {config_path}:", file=sys.stderr)
        print((result.stdout + result.stderr).strip(), file=sys.stderr)
        sys.exit(1)


def custom_envoy_config_warnings(config_path: Path, port: int, admin_port: int) -> List[str]:
    """What a caller-supplied config lacks for the rest of the container to work."""
    try:
        with open(config_path) as f:
            config = yaml.safe_load(f)
        listeners = (config.get("static_resources") or {}).get("listeners") or []
        listener_ports = {
            ((l.get("address") or {}).get("socket_address") or {}).get("port_value")
            for l in listeners
        }
        admin = ((config.get("admin") or {}).get("address") or {}).get("socket_address") or {}
        admin_port_in_file = admin.get("port_value")
    except Exception as e:  # not YAML/JSON, or not the expected shape
        return [f"could not read {config_path} to check its ports ({e})"]
    warnings = []
    if port not in listener_ports:
        warnings.append(f"no listener on the gRPC port {port}: the gateway and gRPC callers "
                        f"will not reach the workers")
    if admin_port_in_file != admin_port:
        warnings.append(f"no admin interface on port {admin_port}: GET /status and the "
                        f"capacity block of GET /meta will be empty")
    return warnings


